{{define "server-about"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <h1 class="page-title">{{ tf "about.page_title" "app_name" .AppName }}</h1>
        {{if .AppTagline}}<p class="page-lead">{{.AppTagline}}</p>{{else}}{{ if .AppDescription }}<p class="page-lead">{{ .AppDescription }}</p>{{ else }}<p class="page-lead">{{ tf "about.intro" "app_name" .AppName }}</p>{{ end }}{{end}}
    </header>
    {{ if operatorContentConfigured "about" }}<section class="section-card" aria-labelledby="about-description-heading"><h2 id="about-description-heading">{{ t "about.what_is" }}</h2>{{ operatorHTML "about" }}</section>{{ end }}

        <section class="section-card" aria-labelledby="about-features">
        <h2 id="about-features">{{ t "about.features" }}</h2>
        <ul>
            <li><strong>{{ t "about.feature_privacy_label" }}</strong> — {{ t "about.feature_privacy_desc" }}</li>
            <li><strong>{{ t "about.feature_multi_engine" }}</strong> — {{ t "about.feature_multi_engine_desc" }}</li>
            <li><strong>{{ t "about.feature_streaming" }}</strong> — {{ t "about.feature_streaming_desc" }}</li>
            <li><strong>{{ t "about.feature_thumbnail_proxy" }}</strong> — {{ t "about.feature_thumbnail_proxy_desc" }}</li>
            <li><strong>{{ t "about.feature_preview" }}</strong> — {{ t "about.feature_preview_desc" }}</li>
            <li><strong>{{ t "about.feature_client_prefs" }}</strong> — {{ t "about.feature_client_prefs_desc" }}</li>
            <li><strong>{{ t "about.feature_tor_label" }}</strong> — {{ t "about.feature_tor_desc" }}</li>
            <li><strong>{{ t "about.feature_geo" }}</strong> — {{ t "about.feature_geo_desc" }}</li>
            <li><strong>{{ t "about.feature_binary" }}</strong> — {{ t "about.feature_binary_desc" }}</li>
        </ul>
        </section>

        <section class="section-card" aria-labelledby="about-version">
        <h2 id="about-version">{{ t "about.version_info" }}</h2>
        <p><strong>{{ t "about.version_label" }}:</strong> <code>{{.Version}}</code></p>
        <p><strong>{{ t "about.build_label" }}:</strong> {{.BuildDateTime}}</p>
        </section>

        <section class="section-card" aria-labelledby="about-links">
        <h2 id="about-links">{{ t "about.links" }}</h2>
        <ul>
            <li><a href="https://github.com/apimgr/vidveil" target="_blank" rel="noopener">{{ t "about.link_source" }}</a> — {{ t "about.link_source_desc" }}</li>
            <li><a href="https://x.scour.li" target="_blank" rel="noopener">{{ t "about.link_official" }}</a></li>
            <li><a href="{{ path "/server/help" }}">{{ t "about.link_help" }}</a></li>
            <li><a href="{{ path "/server/privacy" }}">{{ t "about.link_privacy" }}</a></li>
            <li><a href="{{ path "/server/dpo" }}">{{ t "about.link_dpo" }}</a></li>
        </ul>
        </section>

        <section class="section-card" aria-labelledby="about-attribution">
        <h2 id="about-attribution">{{ t "about.attribution" }}</h2>
        <p><a href="https://db-ip.com/">{{ t "about.attribution_dbip" }}</a></p>
        <p>{{ t "about.attribution_nro" }}</p>
        </section>
</div>
{{end}}
