{{define "server-security"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="content">
    <div class="prose">
        <h1>Security</h1>

        <p>We take security seriously and welcome responsible disclosure of vulnerabilities.</p>

        <h2>Reporting Channels</h2>
        <p>In order of preference:</p>
        <ul>
            {{range .Contacts}}
            <li><a href="{{.}}">{{.}}</a></li>
            {{end}}
        </ul>

        {{if .Expires}}
        <p><strong>Expires:</strong> {{.Expires}}</p>
        {{end}}

        {{if .HasPGPKey}}
        <p>Reports can be encrypted with our <a href="/.well-known/pgp-key.asc">PGP public key</a>.</p>
        {{end}}

        <h2>How to Report</h2>
        <p>Use the second contact link above — it opens our contact form in security-report mode
        (coordinated-disclosure fields, encrypted at rest). We aim to acknowledge new reports promptly
        and work with you toward a coordinated disclosure window of {{.DisclosureDays}} days.</p>

        <h2>More Information</h2>
        <ul>
            <li><a href="/server/security/policy">Disclosure Policy</a></li>
            <li><a href="/server/security/thanks">Researcher Acknowledgments</a></li>
            <li><a href="/.well-known/security.txt">security.txt</a> (machine-readable, RFC 9116)</li>
        </ul>
    </div>
</div>
{{end}}
