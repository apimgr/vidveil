{{define "server-help"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="container container-md">
        <header class="page-header">
            <h1 class="page-title">{{ t "help.title" }}</h1>
            <p class="page-lead">{{ tf "help.intro" "app_name" .AppName }}</p>
        </header>

        <section class="section-card" aria-labelledby="help-basic_search-heading">
        <h2 id="help-basic_search-heading">{{ t "help.basic_search" }}</h2>
        <p>{{ t "help.basic_search_body" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-search_operators-heading">
        <h2 id="help-search_operators-heading">{{ t "help.search_operators" }}</h2>
        <p>{{ t "help.search_operators_intro" }}</p>
        <ul>
            <li><code>+word</code> - {{ t "help.op_require" }}</li>
            <li><code>-word</code> - {{ t "help.op_exclude" }}</li>
            <li><code>"exact phrase"</code> - {{ t "help.op_phrase" }}</li>
        </ul>
        <p>{{ t "help.search_operators_example" }} <code>+lesbian -amateur "hot tub"</code></p>

        </section>
        <section class="section-card" aria-labelledby="help-bang_shortcuts-heading">
        <h2 id="help-bang_shortcuts-heading">{{ t "help.bang_shortcuts" }}</h2>
        <p>{{ t "help.bang_shortcuts_intro" }}</p>
        <ul>
            <li><code>!ph nature</code> - {{ t "help.bang_example_ph" }}</li>
            <li><code>!xv sunset</code> - {{ t "help.bang_example_xv" }}</li>
            <li><code>!ph !rt beach</code> - {{ t "help.bang_example_multi" }}</li>
        </ul>
        <p>{{ t "help.bang_shortcuts_body" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-available_bangs-heading">
        <h2 id="help-available_bangs-heading">{{ t "help.available_bangs" }}</h2>
        <p>{{ t "help.available_bangs_intro_1" }} <a href="{{ path "/search" }}?q=!">{{ t "help.search_page_link" }}</a> {{ t "help.available_bangs_intro_2" }}</p>
        <pre class="code-block"><code>curl {{.BaseURL}}{{.APIBase}}/bangs</code></pre>
        <button type="button" class="copy-btn" aria-label="{{ t "action.copy" }}"><span aria-live="polite">{{ t "action.copy" }}</span></button>

        </section>
        <section class="section-card" aria-labelledby="help-autocomplete-heading">
        <h2 id="help-autocomplete-heading">{{ t "help.autocomplete" }}</h2>
        <p>{{ t "help.autocomplete_body" }}</p>
        <pre class="code-block"><code>curl "{{.BaseURL}}{{.APIBase}}/bangs/autocomplete?q=!p"</code></pre>
        <button type="button" class="copy-btn" aria-label="{{ t "action.copy" }}"><span aria-live="polite">{{ t "action.copy" }}</span></button>

        </section>
        <section class="section-card" aria-labelledby="help-preferences-heading">
        <h2 id="help-preferences-heading">{{ t "help.preferences" }}</h2>
        <p>{{ t "help.preferences_intro" }} <a href="{{ path "/server/preferences" }}">{{ t "help.preferences_link" }}</a>:</p>
        <ul>
            <li>{{ t "help.pref_theme" }}</li>
            <li>{{ t "help.pref_results_page" }}</li>
            <li>{{ t "help.pref_new_tab" }}</li>
            <li>{{ t "help.pref_engines" }}</li>
        </ul>
        <p>{{ t "help.preferences_storage" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-history_favorites-heading">
        <h2 id="help-history_favorites-heading">{{ t "help.history_favorites" }}</h2>
        <p><a href="{{ path "/favorites" }}">{{ t "help.favorites_link" }}</a> {{ t "help.history_favorites_body" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-video_preview-heading">
        <h2 id="help-video_preview-heading">{{ t "help.video_preview" }}</h2>
        <p>{{ t "help.video_preview_body" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-thumbnail_proxy-heading">
        <h2 id="help-thumbnail_proxy-heading">{{ t "help.thumbnail_proxy" }}</h2>
        <p>{{ t "help.thumbnail_proxy_body" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-tor_hidden_service-heading">
        <h2 id="help-tor_hidden_service-heading">{{ t "help.tor_hidden_service" }}</h2>
        <p>{{if .TorOnionAddr}}{{ tf "help.tor_reachable" "onion_address" .TorOnionAddr }}{{else}}{{ t "help.tor_auto" }}{{end}}</p>

        </section>
        <section class="section-card" aria-labelledby="help-age_verification-heading">
        <h2 id="help-age_verification-heading">{{ t "help.age_verification" }}</h2>
        <p>{{ t "help.age_verification_body" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-keyboard_shortcuts-heading">
        <h2 id="help-keyboard_shortcuts-heading">{{ t "help.keyboard_shortcuts" }}</h2>
        <ul>
            <li><kbd>/</kbd> - {{ t "help.kbd_focus_search" }}</li>
            <li><kbd>Esc</kbd> - {{ t "help.kbd_close" }}</li>
            <li><kbd>?</kbd> - {{ t "help.kbd_show_help" }}</li>
        </ul>

        </section>
        <section class="section-card" aria-labelledby="help-api_access-heading">
        <h2 id="help-api_access-heading">{{ t "help.api_access" }}</h2>
        <p>{{ tf "help.api_access_body" "app_name" .AppName }}</p>

        <div class="table-wrapper"><table class="data-table">
            <thead><tr><th scope="col">{{ t "help.table_endpoint" }}</th><th scope="col">{{ t "help.table_purpose" }}</th></tr></thead>
            <tbody>
                <tr><td><code>GET {{.APIBase}}/search?q={query}</code></td><td>{{ t "help.endpoint_search" }}</td></tr>
                <tr><td><code>POST {{.APIBase}}/search/batch</code></td><td>{{ t "help.endpoint_batch" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/bangs</code></td><td>{{ t "help.endpoint_bangs" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/bangs/autocomplete?q={partial}</code></td><td>{{ t "help.endpoint_autocomplete" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/engines</code></td><td>{{ t "help.endpoint_engines" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/engines/{name}</code></td><td>{{ t "help.endpoint_engine_detail" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/engines/health</code></td><td>{{ t "help.endpoint_engine_health" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/stats</code></td><td>{{ t "help.endpoint_stats" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/proxy/thumbnails?url={url}</code></td><td>{{ t "help.endpoint_proxy_thumbnails" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/proxy/videos?url={url}</code></td><td>{{ t "help.endpoint_proxy_videos" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/server/healthz</code></td><td>{{ t "help.endpoint_healthz" }}</td></tr>
                <tr><td><code>GET {{.APIBase}}/version</code></td><td>{{ t "help.endpoint_version" }}</td></tr>
            </tbody>
        </table></div>

        <h3>{{ t "help.examples" }}</h3>
        <pre class="code-block"><code>curl "{{.BaseURL}}{{.APIBase}}/search?q=+lesbian+-amateur"

curl -H "Accept: text/event-stream" "{{.BaseURL}}{{.APIBase}}/search?q=sunset"

curl "{{.BaseURL}}{{.APIBase}}/search?q=sunset&engines=ph,xv"

curl "{{.BaseURL}}{{.APIBase}}/engines"

curl "{{.BaseURL}}{{.APIBase}}/server/healthz"

curl "{{.BaseURL}}{{.APIBase}}/search.txt?q=sunset"</code></pre>
        <button type="button" class="copy-btn" aria-label="{{ t "action.copy" }}"><span aria-live="polite">{{ t "action.copy" }}</span></button>

        <h3>{{ t "help.api_documentation" }}</h3>
        <p>{{ tf "help.api_documentation_intro" "app_name" .AppName }}</p>
        <ul>
            <li><a href="{{ path "/server/docs/swagger" }}">{{ t "help.swagger_link" }}</a> — {{ t "help.swagger_desc" }} <code>/api/swagger</code></li>
            <li><a href="{{ path "/server/docs/graphql" }}">{{ t "help.graphiql_link" }}</a> — {{ t "help.graphiql_desc" }} <code>/api/graphql</code></li>
        </ul>

        </section>
        <section class="section-card" aria-labelledby="help-faq-heading">
        <h2 id="help-faq-heading">{{ t "help.faq" }}</h2>

        <h3>{{ tf "help.faq_hosts_q" "app_name" .AppName }}</h3>
        <p>{{ tf "help.faq_hosts_a" "app_name" .AppName }}</p>

        <h3>{{ t "help.faq_account_q" }}</h3>
        <p>{{ tf "help.faq_account_a" "app_name" .AppName }}</p>

        <h3>{{ t "help.faq_no_results_q" }}</h3>
        <p>{{ t "help.faq_no_results_a" }}</p>

        <h3>{{ t "help.faq_logged_q" }}</h3>
        <p>{{ t "help.faq_logged_a" }}</p>

        <h3>{{ t "help.faq_js_q" }}</h3>
        <p>{{ t "help.faq_js_a" }}</p>

        <h3>{{ t "help.faq_specific_sites_q" }}</h3>
        <p>{{ t "help.faq_specific_sites_a" }} <a href="{{ path "/server/preferences" }}">{{ t "help.preferences_link" }}</a>.</p>

        </section>
        <section class="section-card" aria-labelledby="help-troubleshooting-heading">
        <h2 id="help-troubleshooting-heading">{{ t "help.troubleshooting" }}</h2>

        <h3>{{ t "help.ts_no_results_q" }}</h3>
        <p>{{ t "help.ts_no_results_a" }}</p>

        <h3>{{ t "help.ts_rate_limited_q" }}</h3>
        <p>{{ t "help.ts_rate_limited_a" }}</p>

        <h3>{{ t "help.ts_thumbnails_q" }}</h3>
        <p>{{ t "help.ts_thumbnails_a" }}</p>

        <h3>{{ t "help.ts_preview_q" }}</h3>
        <p>{{ t "help.ts_preview_a" }}</p>

        <h3>{{ t "help.ts_sse_q" }}</h3>
        <p>{{ t "help.ts_sse_a" }}</p>

        <h3>{{ t "help.ts_restricted_q" }}</h3>
        <p>{{ t "help.ts_restricted_a" }}</p>

        <h3>{{ t "help.ts_age_loop_q" }}</h3>
        <p>{{ t "help.ts_age_loop_a" }}</p>

        <h3>{{ t "help.ts_favorites_q" }}</h3>
        <p>{{ t "help.ts_favorites_a" }} <a href="{{ path "/favorites" }}">{{ t "help.favorites_link" }}</a>.</p>

        <h3>{{ t "help.ts_prefs_q" }}</h3>
        <p>{{ t "help.ts_prefs_a" }}</p>

        <h3>{{ t "help.ts_tor_q" }}</h3>
        <p>{{ t "help.ts_tor_a" }}</p>

        </section>
        <section class="section-card" aria-labelledby="help-need_more_help-heading">
        <h2 id="help-need_more_help-heading">{{ t "help.need_more_help" }}</h2>
        <p>{{ t "help.need_more_help_body_1" }} <a href="https://github.com/apimgr/vidveil" target="_blank" rel="noopener">{{ t "help.github_link" }}</a> {{ t "help.need_more_help_body_2" }} <a href="{{ path "/server/security" }}">{{ t "security.title" }}</a>.</p>
        {{ with .PageContent }}<div>{{ . | markdownToHTML }}</div>{{ end }}
        </section>
        <section class="section-card" aria-labelledby="more-help-heading">
            <h2 id="more-help-heading">{{ t "help.more" }}</h2>
            <ul class="hub-list">
                {{range .HelpPages}}<li class="hub-item"><a class="hub-link" href="{{path .Path}}"><span class="hub-title">{{t .TitleKey}}</span><span class="hub-desc">{{t .DescriptionKey}}</span></a></li>{{end}}
            </ul>
        </section>
</div>
{{end}}
