{{define "favorites"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
</head>
<body>
    {{template "public/header" .}}
    {{template "public/nav" .}}
    <main class="favorites-page">
        <div class="favorites-toolbar">
            <h1>{{ t "favorites.title" }}</h1>
            <div class="favorites-actions">
                <span id="favorites-count-label" class="favorites-count"></span>
                <button type="button" class="btn-secondary btn-sm" id="export-btn" data-action="export-favs">{{ t "favorites.export" }}</button>
                <label class="btn-secondary btn-sm btn-file">
                    {{ t "favorites.import" }}
                    <input type="file" accept=".json" data-action="import-favs" hidden>
                </label>
                <button type="button" class="btn-danger btn-sm" id="clear-btn" data-action="clear-favs">{{ t "favorites.clear" }}</button>
            </div>
        </div>

        <noscript>
            <p class="favorites-nojs">{{ t "favorites.nojs" }}</p>
        </noscript>

        <div id="favorites-empty" class="favorites-empty" hidden>
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <p>{{ t "favorites.empty" }}</p>
            <p class="favorites-empty-hint">{{ t "favorites.empty_hint" | safeHTML }}</p>
            <a href="/search" class="btn-primary">{{ t "favorites.start_search" }}</a>
        </div>

        <div id="favorites-grid" class="video-grid" role="list" aria-label="{{ t "favorites.title" }}"></div>
    </main>
    {{template "public/footer" .}}
    {{/* i18n strings for the favorites logic in app.js. type="application/json" is
         a non-executable data island (CSP script-src does not block it). */}}
    <script type="application/json" id="favorites-i18n">{
        "countSingular": "{{ t "favorites.count_singular" }}",
        "countPlural": "{{ t "favorites.count" }}",
        "remove": "{{ t "favorites.remove" }}",
        "exported": "{{ t "favorites.exported" }}",
        "imported": "{{ t "favorites.imported" }}",
        "cleared": "{{ t "favorites.cleared" }}",
        "invalidFile": "{{ t "favorites.invalid_file" }}",
        "confirmClear": "{{ t "favorites.confirm_clear" }}"
    }</script>
    {{template "public/scripts" .}}
</body>
</html>
{{end}}
