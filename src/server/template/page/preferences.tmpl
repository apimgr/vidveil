{{define "preferences"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
</head>
<body>
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    {{template "public/site-banner" .}}
    {{template "public/header" .}}
    <main class="preferences" id="main-content" role="main">
        <div class="preferences-header">
            <h1>{{ t "prefs.title" }}</h1>
            <button type="button" class="preferences-close" data-action="close-prefs" aria-label="{{ t "prefs.close" }}">&times;</button>
        </div>
        {{/* data-managed="true" tells the generic setupPreferencesForm() in
             app.js to skip binding its own submit handler — this page's
             dedicated IIFE (favorites/history/engine-tier aware) already
             owns #preferences-form, and without this attribute both handlers
             fired on every submit (double-save). */}}
        {{/* method/action make this form work with JavaScript disabled: the
             server-side handler persists theme/resultsPerPage/openNewTab as
             cookies and redirects. The JS path calls preventDefault() first,
             so the enhanced flow is unchanged. */}}
        <form id="preferences-form" method="post" action="/server/preferences" data-managed="true" data-return-to="{{.ReturnTo}}">
            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
            {{if .ReturnTo}}<input type="hidden" name="redirect" value="{{.ReturnTo}}">{{end}}
            <section>
                <h2>{{ t "prefs.appearance" }}</h2>
                <div class="form-group">
                    <label for="theme">{{ t "prefs.theme" }}:</label>
                    <select id="theme" name="theme">
                        <option value="auto" {{if eq .Theme "auto"}}selected{{end}}>{{ t "prefs.theme.auto" }}</option>
                        <option value="dark" {{if eq .Theme "dark"}}selected{{end}}>{{ t "prefs.theme.dark" }}</option>
                        <option value="light" {{if eq .Theme "light"}}selected{{end}}>{{ t "prefs.theme.light" }}</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="language">Language:</label>
                    <select id="language" name="lang">
                        <option value="en"{{if eq .Lang "en"}} selected{{end}}>English</option>
                        <option value="ar"{{if eq .Lang "ar"}} selected{{end}}>العربية</option>
                        <option value="de"{{if eq .Lang "de"}} selected{{end}}>Deutsch</option>
                        <option value="es"{{if eq .Lang "es"}} selected{{end}}>Español</option>
                        <option value="fr"{{if eq .Lang "fr"}} selected{{end}}>Français</option>
                        <option value="ja"{{if eq .Lang "ja"}} selected{{end}}>日本語</option>
                        <option value="zh"{{if eq .Lang "zh"}} selected{{end}}>中文</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="grid-density">{{ t "prefs.grid_density" }}:</label>
                    <select id="grid-density" name="vidveil_pref_grid_density">
                        <option value="comfortable"{{if eq (index .Prefs "grid_density") "comfortable"}} selected{{end}}>{{ t "prefs.grid_comfortable" }}</option>
                        <option value="default"{{if or (eq (index .Prefs "grid_density") "") (eq (index .Prefs "grid_density") "default")}} selected{{end}}>{{ t "prefs.grid_default" }}</option>
                        <option value="compact"{{if eq (index .Prefs "grid_density") "compact"}} selected{{end}}>{{ t "prefs.grid_compact" }}</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="thumbnail-size">{{ t "prefs.thumbnail_size" }}:</label>
                    <select id="thumbnail-size" name="vidveil_pref_thumbnail_size">
                        <option value="small"{{if eq (index .Prefs "thumbnail_size") "small"}} selected{{end}}>{{ t "prefs.size_small" }}</option>
                        <option value="medium"{{if or (eq (index .Prefs "thumbnail_size") "") (eq (index .Prefs "thumbnail_size") "medium")}} selected{{end}}>{{ t "prefs.size_medium" }}</option>
                        <option value="large"{{if eq (index .Prefs "thumbnail_size") "large"}} selected{{end}}>{{ t "prefs.size_large" }}</option>
                    </select>
                </div>
            </section>

            <section>
                <h2>{{ t "prefs.video_preview" }}</h2>
                <div class="form-group">
                    <label class="toggle">
                        <input type="hidden" name="vidveil_pref_autoplay_preview" value="0">
                        <input type="checkbox" id="autoplay-preview" name="vidveil_pref_autoplay_preview" value="1"{{if or (eq (index .Prefs "autoplay_preview") "") (eq (index .Prefs "autoplay_preview") "1")}} checked{{end}}>
                        <span class="slider"></span>
                        <span class="toggle-label">{{ t "prefs.autoplay_preview" }}</span>
                    </label>
                </div>
                <div class="form-group">
                    <label for="preview-delay">{{ t "prefs.preview_delay" }}:</label>
                    <select id="preview-delay" name="vidveil_pref_preview_delay">
                        <option value="0"{{if or (eq (index .Prefs "preview_delay") "") (eq (index .Prefs "preview_delay") "0")}} selected{{end}}>{{ t "prefs.delay_instant" }}</option>
                        <option value="200"{{if eq (index .Prefs "preview_delay") "200"}} selected{{end}}>{{ t "prefs.delay_short" }}</option>
                        <option value="500"{{if eq (index .Prefs "preview_delay") "500"}} selected{{end}}>{{ t "prefs.delay_medium" }}</option>
                        <option value="1000"{{if eq (index .Prefs "preview_delay") "1000"}} selected{{end}}>{{ t "prefs.delay_long" }}</option>
                    </select>
                </div>
            </section>

            <section>
                <h2>{{ t "prefs.search_settings" }}</h2>
                <div class="form-group">
                    <label for="results-per-page">{{ t "prefs.results_page" }}:</label>
                    <select id="results-per-page" name="vidveil_pref_results_per_page">
                        <option value="20"{{if eq .ResultsPerPage "20"}} selected{{end}}>20</option>
                        <option value="50"{{if eq .ResultsPerPage "50"}} selected{{end}}>50</option>
                        <option value="100"{{if eq .ResultsPerPage "100"}} selected{{end}}>100</option>
                        <option value="0"{{if eq .ResultsPerPage "0"}} selected{{end}}>{{ t "prefs.infinite_scroll" }}</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="toggle">
                        <input type="hidden" name="vidveil_pref_open_new_tab" value="0">
                        <input type="checkbox" id="open-new-tab" name="vidveil_pref_open_new_tab" value="1"{{if .OpenNewTab}} checked{{end}}>
                        <span class="slider"></span>
                        <span class="toggle-label">{{ t "prefs.open_new_tab" }}</span>
                    </label>
                </div>
            </section>

            <section>
                <h2>{{ t "prefs.default_filters" }}</h2>
                <p class="section-description">{{ t "prefs.default_filters_desc" }}</p>
                <div class="form-group">
                    <label class="toggle">
                        <input type="hidden" name="vidveil_pref_default_preview_only" value="0">
                        <input type="checkbox" id="default-preview-only" name="vidveil_pref_default_preview_only" value="1"{{if or (eq (index .Prefs "default_preview_only") "") (eq (index .Prefs "default_preview_only") "1")}} checked{{end}}>
                        <span class="slider"></span>
                        <span class="toggle-label">{{ t "prefs.preview_only" }}</span>
                    </label>
                    <p class="form-hint">{{ t "prefs.preview_only_hint" }}</p>
                </div>
                <div class="form-group">
                    <label class="toggle">
                        <input type="hidden" name="vidveil_pref_show_ai_content" value="0">
                        <input type="checkbox" id="show-ai-content" name="vidveil_pref_show_ai_content" value="1"{{if eq (index .Prefs "show_ai_content") "1"}} checked{{end}}>
                        <span class="slider"></span>
                        <span class="toggle-label">{{ t "prefs.show_synthetic_content" }}</span>
                    </label>
                    <p class="form-hint">{{ t "prefs.show_synthetic_hint" }}</p>
                </div>
                <div class="form-group">
                    <label for="default-duration">{{ t "prefs.default_duration" }}:</label>
                    <select id="default-duration" name="vidveil_pref_default_duration">
                        <option value="any"{{if or (eq (index .Prefs "default_duration") "") (eq (index .Prefs "default_duration") "any")}} selected{{end}}>{{ t "filter.any" }}</option>
                        <option value="short"{{if eq (index .Prefs "default_duration") "short"}} selected{{end}}>{{ t "filter.under_10" }}</option>
                        <option value="medium"{{if eq (index .Prefs "default_duration") "medium"}} selected{{end}}>{{ t "filter.10_30" }}</option>
                        <option value="long"{{if eq (index .Prefs "default_duration") "long"}} selected{{end}}>{{ t "filter.over_30" }}</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="min-quality">{{ t "prefs.min_quality" }}:</label>
                    <select id="min-quality" name="vidveil_pref_min_quality">
                        <option value="0"{{if eq (index .Prefs "min_quality") "0"}} selected{{end}}>{{ t "prefs.any_quality" }}</option>
                        <option value="240"{{if eq (index .Prefs "min_quality") "240"}} selected{{end}}>240p+</option>
                        <option value="360"{{if or (eq (index .Prefs "min_quality") "") (eq (index .Prefs "min_quality") "360")}} selected{{end}}>{{ t "prefs.quality_recommended" }}</option>
                        <option value="480"{{if eq (index .Prefs "min_quality") "480"}} selected{{end}}>480p+</option>
                        <option value="720"{{if eq (index .Prefs "min_quality") "720"}} selected{{end}}>{{ t "prefs.quality_hd" }}</option>
                        <option value="1080"{{if eq (index .Prefs "min_quality") "1080"}} selected{{end}}>{{ t "prefs.quality_fhd" }}</option>
                        <option value="2160"{{if eq (index .Prefs "min_quality") "2160"}} selected{{end}}>{{ t "prefs.quality_4k" }}</option>
                    </select>
                    <p class="form-hint">{{ t "prefs.quality_hint" }}</p>
                </div>
                <div class="form-group">
                    <label for="default-sort">{{ t "prefs.default_sort" }}:</label>
                    <select id="default-sort" name="vidveil_pref_default_sort">
                        <option value="any"{{if or (eq (index .Prefs "default_sort") "") (eq (index .Prefs "default_sort") "any")}} selected{{end}}>{{ t "prefs.sort_relevance" }}</option>
                        <option value="duration-desc"{{if eq (index .Prefs "default_sort") "duration-desc"}} selected{{end}}>{{ t "prefs.sort_longest" }}</option>
                        <option value="duration-asc"{{if eq (index .Prefs "default_sort") "duration-asc"}} selected{{end}}>{{ t "prefs.sort_shortest" }}</option>
                        <option value="views"{{if eq (index .Prefs "default_sort") "views"}} selected{{end}}>{{ t "prefs.sort_views" }}</option>
                        <option value="quality"{{if eq (index .Prefs "default_sort") "quality"}} selected{{end}}>{{ t "prefs.sort_quality" }}</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="min-duration">{{ t "prefs.min_duration" }}:</label>
                    <select id="min-duration" name="vidveil_pref_min_duration">
                        <option value="0"{{if eq (index .Prefs "min_duration") "0"}} selected{{end}}>{{ t "prefs.no_minimum" }}</option>
                        <option value="60"{{if eq (index .Prefs "min_duration") "60"}} selected{{end}}>1 {{ t "time.minute" }}</option>
                        <option value="180"{{if eq (index .Prefs "min_duration") "180"}} selected{{end}}>3 {{ t "time.minutes_plural" }}</option>
                        <option value="300"{{if eq (index .Prefs "min_duration") "300"}} selected{{end}}>5 {{ t "time.minutes_plural" }}</option>
                        <option value="600"{{if or (eq (index .Prefs "min_duration") "") (eq (index .Prefs "min_duration") "600")}} selected{{end}}>10 {{ t "time.minutes_plural" }}</option>
                        <option value="1200"{{if eq (index .Prefs "min_duration") "1200"}} selected{{end}}>20 {{ t "time.minutes_plural" }}</option>
                        <option value="1800"{{if eq (index .Prefs "min_duration") "1800"}} selected{{end}}>30 {{ t "time.minutes_plural" }}</option>
                    </select>
                </div>
            </section>

            <section>
                <h2>{{ t "prefs.history" }}</h2>
                <div class="form-group">
                    <label for="max-history">{{ t "prefs.max_history" }}:</label>
                    <select id="max-history" name="vidveil_pref_max_history">
                        <option value="0"{{if or (eq (index .Prefs "max_history") "") (eq (index .Prefs "max_history") "0")}} selected{{end}}>{{ t "prefs.unlimited" }}</option>
                        <option value="10"{{if eq (index .Prefs "max_history") "10"}} selected{{end}}>10</option>
                        <option value="25"{{if eq (index .Prefs "max_history") "25"}} selected{{end}}>25</option>
                        <option value="50"{{if eq (index .Prefs "max_history") "50"}} selected{{end}}>50</option>
                        <option value="100"{{if eq (index .Prefs "max_history") "100"}} selected{{end}}>100</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="auto-clear-history">{{ t "prefs.auto_clear_history" }}:</label>
                    <select id="auto-clear-history" name="vidveil_pref_auto_clear_history">
                        <option value="0"{{if or (eq (index .Prefs "auto_clear_history") "") (eq (index .Prefs "auto_clear_history") "0")}} selected{{end}}>{{ t "prefs.never" }}</option>
                        <option value="1"{{if eq (index .Prefs "auto_clear_history") "1"}} selected{{end}}>{{ t "prefs.after_1_day" }}</option>
                        <option value="7"{{if eq (index .Prefs "auto_clear_history") "7"}} selected{{end}}>{{ t "prefs.after_7_days" }}</option>
                        <option value="30"{{if eq (index .Prefs "auto_clear_history") "30"}} selected{{end}}>{{ t "prefs.after_30_days" }}</option>
                    </select>
                </div>
                <div class="form-group form-group--buttons">
                    <button type="button" class="btn-secondary" data-action="export-history">{{ t "prefs.export_history" }}</button>
                    <label class="btn-secondary btn-file">
                        {{ t "prefs.import_history" }}
                        <input type="file" accept=".json" data-action="import-history" hidden>
                    </label>
                    <button type="button" class="btn-danger" data-action="clear-history">{{ t "prefs.clear_history" }}</button>
                </div>
            </section>

            <section>
                <h2>{{ t "favorites.title" }}</h2>
                <p class="section-description"><span id="favorites-count" data-format="{{ t "favorites.count" }}">{{ tf "favorites.count" "count" .FavoritesCount }}</span></p>
                <div class="form-group form-group--buttons">
                    <a class="btn-secondary" href="/favorites/export">{{ t "favorites.export" }}</a>
                    <input type="file" form="favorites-import-form" name="file" accept=".json" class="favorites-import-input" aria-label="{{ t "favorites.import" }}">
                    <button type="submit" form="favorites-import-form" class="btn-secondary" data-loading-text="{{ t "action.importing" }}">{{ t "favorites.import" }}</button>
                    <button type="submit" form="favorites-clear-form" class="btn-danger">{{ t "favorites.clear" }}</button>
                </div>
            </section>

            <section>
                <h2>{{ t "prefs.sync" }}</h2>
                <p class="section-description">{{ t "prefs.sync_desc" }}</p>
                {{if .PreferenceExportURL}}
                <div class="form-group">
                    <label for="sync-url">{{ t "prefs.sync_url_label" }}</label>
                    <input type="text" id="sync-url" readonly value="{{.PreferenceExportURL}}">
                </div>
                <div class="form-group">
                    <label for="sync-code">{{ t "prefs.sync_code_label" }}</label>
                    <input type="text" id="sync-code" readonly value="{{.PreferenceExportCode}}">
                </div>
                {{else}}
                <div class="form-group form-group--buttons">
                    <a class="btn-secondary" href="/server/preferences/export">{{ t "prefs.sync_export" }}</a>
                </div>
                {{end}}
                <div class="form-group">
                    <label for="sync-import-code">{{ t "prefs.sync_import_label" }}</label>
                    <input type="text" id="sync-import-code" form="preferences-import-form" name="code" placeholder="{{ t "prefs.sync_import_placeholder" }}">
                </div>
                <button type="submit" form="preferences-import-form" class="btn-secondary">{{ t "prefs.sync_import" }}</button>
            </section>

            <section>
                <h2>{{ t "prefs.privacy" }}</h2>
                <div class="form-group">
                    <label class="toggle">
                        <input type="hidden" name="vidveil_pref_use_tor" value="0">
                        <input type="checkbox" id="use-tor" name="vidveil_pref_use_tor" value="1"{{if eq (index .Prefs "use_tor") "1"}} checked{{end}}>
                        <span class="slider"></span>
                        <span class="toggle-label">{{ t "prefs.use_tor" }}</span>
                    </label>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" checked disabled>
                        {{ t "prefs.proxy_thumbnails_locked" }}
                    </label>
                </div>
            </section>

            <section>
                <h2>{{ t "prefs.engines" }}</h2>
                <p class="section-description">{{ t "prefs.engines_desc" }}</p>
                <div class="engine-tiers" id="engine-tiers">
                    {{range .Engines}}
                    <label class="engine-toggle" data-tier="{{.Tier}}" data-engine="{{.Name}}">
                        <input type="checkbox" name="engines" value="{{.Name}}" {{if .Enabled}}checked{{end}}>
                        {{.DisplayName}}
                    </label>
                    {{end}}
                </div>
                <div class="engine-actions">
                    <button type="button" data-action="select-all-engines">{{ t "search.select_all" }}</button>
                    <button type="button" data-action="select-none-engines">{{ t "search.deselect_all" }}</button>
                </div>
            </section>

            <div class="form-actions">
                <button type="submit" class="primary" id="preferences-save-btn">{{ t "prefs.save" }}</button>
                <button type="button" data-action="reset-preferences">{{ t "prefs.reset" }}</button>
            </div>
        </form>
        <section aria-labelledby="owner-tokens-heading">
            <h2 id="owner-tokens-heading">{{ t "owner_tokens.title" }}</h2>
            {{if .OwnerTokenEnabled}}
            <p>{{ t "owner_tokens.primary_token" }}: <code>tok_••••••••••••{{.PrimaryToken.Suffix}}</code></p>
            <p>{{ t "owner_tokens.created_at" }}: <time>{{.PrimaryToken.Created}}</time> · {{ t "owner_tokens.last_used" }}: {{if .PrimaryToken.LastUsed}}{{.PrimaryToken.LastUsed}}{{else}}{{ t "owner_tokens.never_used" }}{{end}}</p>
            <form method="post" action="/server/preferences/token/reveal">{{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}<button type="submit" class="btn-secondary">{{ t "owner_tokens.reveal_primary" }}</button></form>
            <form method="post" action="/server/preferences/token/rotate">{{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}<label><input type="checkbox" name="confirm" value="rotate" required>{{ t "owner_tokens.rotate_warning" }}</label><button type="submit" class="btn-danger">{{ t "owner_tokens.rotate_primary" }}</button></form>
            <h3>{{ t "owner_tokens.linked_tokens" }}</h3>
            {{range .LinkedTokens}}
            <article><p><strong>{{.Name}}</strong> <code>tok_••••••••••••{{.Suffix}}</code> — {{if eq .Status "active"}}{{ t "owner_tokens.status_active" }}{{else if eq .Status "expired"}}{{ t "owner_tokens.status_expired" }}{{else}}{{ t "owner_tokens.status_revoked" }}{{end}}</p>
                <p>{{ t "owner_tokens.created_at" }}: <time>{{.Created}}</time> · {{ t "owner_tokens.last_used" }}: {{if .LastUsed}}{{.LastUsed}}{{else}}{{ t "owner_tokens.never_used" }}{{end}} · {{ t "owner_tokens.expires" }}: {{if eq .Expires "never"}}{{ t "owner_tokens.never" }}{{else}}{{.Expires}}{{end}}</p>
                {{if ne .Status "revoked"}}
                <form method="post" action="/server/preferences/tokens/{{.ID}}/reveal">{{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit">{{ t "owner_tokens.reveal" }}</button></form>
                <form method="post" action="/server/preferences/tokens/{{.ID}}/rotate">{{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit">{{ t "owner_tokens.rotate" }}</button></form>
                <form method="post" action="/server/preferences/tokens/{{.ID}}/update">{{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<label>{{ t "owner_tokens.name" }} <input name="name" value="{{.Name}}" required maxlength="64"></label><label>{{ t "owner_tokens.expiry_format" }} <input name="expires" value="{{.Expires}}" required></label><button type="submit">{{ t "owner_tokens.update" }}</button></form>
                {{if eq .Status "active"}}<form method="post" action="/server/preferences/tokens/{{.ID}}/revoke">{{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit" class="btn-danger">{{ t "owner_tokens.revoke" }}</button></form>{{end}}
                {{end}}
            </article>
            {{end}}
            <h3>{{ t "owner_tokens.create_linked" }}</h3>
            <form method="post" action="/server/preferences/tokens">{{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}<label>{{ t "owner_tokens.name" }} <input name="name" required minlength="1" maxlength="64"></label><label>{{ t "owner_tokens.expiry" }} <select name="expires_preset"><option value="never">{{ t "owner_tokens.never" }}</option><option value="7d">{{ t "owner_tokens.days_7" }}</option><option value="30d">{{ t "owner_tokens.days_30" }}</option><option value="90d">{{ t "owner_tokens.days_90" }}</option><option value="1y">{{ t "owner_tokens.year_1" }}</option></select></label><label>{{ t "owner_tokens.custom_expiry" }} <input type="date" name="expires_date"></label><button type="submit" class="btn-secondary">{{ t "owner_tokens.create_linked" }}</button></form>
            {{else}}
            <p>{{ t "owner_tokens.restore_description" }}</p>
            <form method="post" action="/server/preferences/token/restore">{{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}<label for="owner-token-restore">{{ t "owner_tokens.primary_token" }}</label><input id="owner-token-restore" name="token" type="password" autocomplete="off" required><button type="submit" class="btn-secondary">{{ t "owner_tokens.restore" }}</button></form>
            {{end}}
        </section>
        <form id="favorites-import-form" action="/favorites/import" method="post" enctype="multipart/form-data" class="favorites-import-form">
            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
        </form>
        <form id="favorites-clear-form" action="/favorites" method="post" class="favorites-clear-form" data-action="clear-favorites-form" data-confirm="{{ t "favorites.confirm_clear" }}">
            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
            <input type="hidden" name="_method" value="DELETE">
        </form>
        <form id="preferences-import-form" method="get" action="/server/preferences/import"></form>
        <section aria-labelledby="consent-heading">
            <h2 id="consent-heading">{{ t "privacy.cookie_preferences" }}</h2>
            <form method="post" action="/server/consent">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <input type="hidden" name="choice" value="save">
                <label><input type="checkbox" checked disabled> {{ t "privacy.cookie_essential" }}</label>
                <label><input type="checkbox" name="preferences" value="1"{{if .ConsentPreferences}} checked{{end}}> {{ t "privacy.cookie_preferences" }}</label>
                <label><input type="checkbox" disabled{{if .AnalyticsConsent}} checked{{end}}> {{ t "privacy.cookie_analytics" }}</label>
                <button type="submit" class="btn-secondary">{{ t "prefs.save" }}</button>
            </form>
        </section>
        {{if .DataSold}}
        <section aria-labelledby="ccpa-heading">
            <h2 id="ccpa-heading">{{ t "privacy.ccpa_title" }}</h2>
            <p>{{ t "privacy.ccpa_body" }}</p>
            <form method="post" action="/server/ccpa">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                {{if .CCPAOptedOut}}<input type="hidden" name="choice" value="opt-in"><button type="submit" class="btn-secondary">{{ t "privacy.ccpa_opt_in" }}</button>
                {{else}}<input type="hidden" name="choice" value="opt-out"><button type="submit" class="btn-primary">{{ t "privacy.ccpa_opt_out" }}</button>{{end}}
            </form>
        </section>
        {{end}}
    </main>
    {{template "public/footer" .}}
    {{/* i18n strings for the preferences logic in app.js. type="application/json" is
         a non-executable data island (CSP script-src does not block it). */}}
    <script type="application/json" id="preferences-i18n">{
        "saving": "{{ t "prefs.saving" }}",
        "saved": "{{ t "prefs.saved" }}",
        "resetDone": "{{ t "prefs.reset_done" }}",
        "favCleared": "{{ t "favorites.cleared" }}",
        "tier1": "{{ t "tier.1" }}",
        "tier2": "{{ t "tier.2" }}",
        "tier3": "{{ t "tier.3" }}",
        "tier4": "{{ t "tier.4" }}",
        "tier5": "{{ t "tier.5" }}",
        "tier6": "{{ t "tier.6" }}",
        "tierEngines": "{{ t "tier.engines" }}",
        "expandTier": "{{ t "a11y.expand_tier" }}",
        "historyExported": "{{ t "history.exported" }}",
        "historyImported": "{{ t "history.imported" }}",
        "historyInvalidFile": "{{ t "history.invalid_file" }}",
        "historyParseFailed": "{{ t "history.parse_failed" }}",
        "historyClearConfirm": "{{ t "history.clear_confirm" }}",
        "historyCleared": "{{ t "history.cleared" }}"
    }</script>
    {{template "public/scripts" .}}
</body>
</html>
{{end}}
