{{define "server-contact"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="content">
    <div class="prose">
        <h1>{{ t "contact.title" }}</h1>

        <p>This form is only for security reports, terms violations at a URL on this site, DMCA notices and privacy requests. It cannot be used for support, bug reports, feature requests or general questions.</p>
        {{if .Message}}
        <div class="alert alert-{{.MessageType}}" role="status">{{.Message}}</div>
        {{end}}

        {{if .SecurityMode}}
        <h2>{{ t "contact.security_report_title" }}</h2>
        <p>{{ t "contact.security_report_body" }}</p>
        {{if .ReviewMode}}
        <section class="contact-review" aria-labelledby="contact-review-title">
            <h3 id="contact-review-title">Review your report</h3>
            <p><strong>Email</strong>: {{index .FormValues "email"}}</p>
            <p><strong>Type</strong>: Security</p>
            <p><strong>Subject</strong>: {{index .FormValues "subject"}}</p>
            <form method="POST" action="{{ path "/server/contact" }}?security_id={{.SecurityID}}">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
                {{range $key, $value := .FormValues}}{{if and (ne $key "form_token") (ne $key "step") (ne $key "type")}}<input type="hidden" name="{{$key}}" value="{{$value}}">{{end}}{{end}}
                <input type="hidden" name="type" value="security">
                <input type="hidden" name="step" value="confirm">
                <input type="hidden" name="review_token" value="{{.ReviewToken}}">
                <label><input type="checkbox" name="confirmed" value="true" required> This email address is correct, and this is a genuine report, not an advertisement, a solicitation or spam</label>
                <button type="submit" class="search-button">Confirm report</button>
            </form>
            <form method="POST" action="{{ path "/server/contact" }}?security_id={{.SecurityID}}">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
                {{range $key, $value := .FormValues}}{{if and (ne $key "form_token") (ne $key "step") (ne $key "type")}}<input type="hidden" name="{{$key}}" value="{{$value}}">{{end}}{{end}}
                <input type="hidden" name="type" value="security">
                <input type="hidden" name="step" value="edit">
                <button type="submit" class="btn-secondary">Edit report</button>
            </form>
        </section>
        {{else}}
        <form method="POST" action="{{ path "/server/contact" }}?security_id={{.SecurityID}}" class="preferences-form">
            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
            <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
            <input type="hidden" name="security_id" value="{{.SecurityID}}">
            <input type="hidden" name="type" value="security">
            <input type="hidden" name="step" value="submit">
            <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
                <label for="website">Leave this field empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>
            <div class="form-group">
                <label class="form-label" for="name">{{ t "contact.label_name" }}</label>
                <input class="form-input" type="text" id="name" name="name" required maxlength="100" value="{{index .FormValues "name"}}">
            </div>
            <div class="form-group">
                <label class="form-label" for="email">{{ t "contact.label_email" }}</label>
                <input class="form-input" aria-describedby="email-error" aria-invalid="false" type="email" id="email" name="email" required maxlength="254" placeholder="{{ t "contact.placeholder_email" }}" value="{{index .FormValues "email"}}">
                <p id="email-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="researcher_gpg">{{ t "contact.label_researcher_gpg" }}</label>
                <textarea class="form-input" id="researcher_gpg" name="researcher_gpg" rows="3" maxlength="16384" placeholder="{{ t "contact.placeholder_researcher_gpg" }}"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label" for="component">{{ t "contact.label_component" }}</label>
                <select class="form-input" aria-describedby="component-error" aria-invalid="false" id="component" name="component" required>
                    <option value="">{{ t "contact.select_component_placeholder" }}</option>
                    {{range .Components}}
                    <option value="{{.}}">{{.}}</option>
                    {{end}}
                    <option value="other">{{ t "contact.option_other" }}</option>
                </select>
                <p id="component-error" class="field-error" role="alert" hidden></p>
                <input class="form-input" type="text" id="component_other" name="component_other" maxlength="255" placeholder="{{ t "contact.placeholder_component_other" }}">
            </div>
            <div class="form-group">
                <label class="form-label" for="endpoint">{{ t "contact.label_endpoint" }}</label>
                <input class="form-input" type="text" id="endpoint" name="endpoint" maxlength="2048" placeholder="/api/v1/search">
            </div>
            <div class="form-group">
                <label class="form-label" for="severity">{{ t "contact.label_severity" }}</label>
                <select class="form-input" aria-describedby="severity-error" aria-invalid="false" id="severity" name="severity" required>
                    <option value="critical">{{ t "contact.severity_critical" }}</option>
                    <option value="high">{{ t "contact.severity_high" }}</option>
                    <option value="medium" selected>{{ t "contact.severity_medium" }}</option>
                    <option value="low">{{ t "contact.severity_low" }}</option>
                    <option value="informational">{{ t "contact.severity_informational" }}</option>
                </select>
                <p id="severity-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="summary">{{ t "contact.label_summary" }}</label>
                <input class="form-input" aria-describedby="summary-error" aria-invalid="false" type="text" id="summary" name="summary" required maxlength="200" placeholder="{{ t "contact.placeholder_summary" }}" value="{{index .FormValues "summary"}}">
                <p id="summary-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="steps">{{ t "contact.label_steps" }}</label>
                <textarea class="form-input" aria-describedby="steps-error" aria-invalid="false" id="steps" name="steps" required maxlength="10000" rows="5"></textarea>
                <p id="steps-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="impact">{{ t "contact.label_impact" }}</label>
                <textarea class="form-input" aria-describedby="impact-error" aria-invalid="false" id="impact" name="impact" required maxlength="5000" rows="4"></textarea>
                <p id="impact-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="suggested_fix">{{ t "contact.label_suggested_fix" }}</label>
                <textarea class="form-input" id="suggested_fix" name="suggested_fix" maxlength="5000" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label"><input type="checkbox" name="cve_requested" value="1"> {{ t "contact.label_cve" }}</label>
            </div>
            <div class="form-group">
                <label class="form-label" for="disclosure_days">{{ t "contact.label_disclosure_days" }}</label>
                <input class="form-input" type="number" id="disclosure_days" name="disclosure_days" min="1" value="{{.DefaultDisclosureDays}}">
            </div>
            <div class="form-group">
                <label class="form-label" for="credit_preference">{{ t "contact.label_credit_preference" }}</label>
                <select class="form-input" aria-describedby="credit_preference-error" aria-invalid="false" id="credit_preference" name="credit_preference" required>
                    <option value="real_name">{{ t "contact.credit_real_name" }}</option>
                    <option value="handle">{{ t "contact.credit_handle" }}</option>
                    <option value="anonymous">{{ t "contact.credit_anonymous" }}</option>
                    <option value="none">{{ t "contact.credit_none" }}</option>
                </select>
                <p id="credit_preference-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="credit_handle">{{ t "contact.label_credit_name" }}</label>
                <input class="form-input" type="text" id="credit_handle" name="credit_handle" maxlength="100">
                <p>{{ t "contact.credit_handle_hint" }}</p>
            </div>
            <div class="form-group">
                <label class="form-label"><input type="checkbox" name="disclosure_agreement" value="1" required> {{ t "contact.label_disclosure_agreement" }}</label>
            </div>
            {{ if eq .CaptchaType "simple" }}
            <div class="form-group">
                <label class="form-label" for="captcha_answer">{{ t "contact.captcha_question" }}: {{ .CaptchaQuestion }}</label>
                <input class="form-input" type="hidden" name="captcha_id" value="{{ .CaptchaID }}">
                <input class="form-input" type="number" id="captcha_answer" name="captcha_answer" required inputmode="numeric">
            </div>
            {{ else if eq .CaptchaType "recaptcha" }}
            <div class="g-recaptcha" data-sitekey="{{ .CaptchaSiteKey }}"></div>
            <script async defer src="https://www.google.com/recaptcha/api.js"></script>
            <noscript>
                <div class="form-group">
                    <label class="form-label" for="captcha_fallback_answer">{{ t "contact.captcha_question" }}: {{ .CaptchaFallbackQuestion }}</label>
                    <input class="form-input" type="hidden" name="captcha_id" value="{{ .CaptchaFallbackID }}">
                    <input class="form-input" type="number" id="captcha_fallback_answer" name="captcha_answer" required inputmode="numeric">
                </div>
            </noscript>
            {{ else if eq .CaptchaType "hcaptcha" }}
            <div class="h-captcha" data-sitekey="{{ .CaptchaSiteKey }}"></div>
            <script async defer src="https://js.hcaptcha.com/1/api.js"></script>
            <noscript>
                <div class="form-group">
                    <label class="form-label" for="captcha_fallback_answer">{{ t "contact.captcha_question" }}: {{ .CaptchaFallbackQuestion }}</label>
                    <input class="form-input" type="hidden" name="captcha_id" value="{{ .CaptchaFallbackID }}">
                    <input class="form-input" type="number" id="captcha_fallback_answer" name="captcha_answer" required inputmode="numeric">
                </div>
            </noscript>
            {{ end }}
            <button type="submit" class="search-button" data-loading-text="{{ t "action.submitting" }}">{{ t "contact.submit_security_report" }}</button>
        </form>
        {{end}}
        {{else}}
        {{if .ContactEnabled}}
        <h2>{{ t "contact.form_title" }}</h2>
        {{if .ReviewMode}}
        <section class="contact-review" aria-labelledby="contact-review-title">
            <h3 id="contact-review-title">Review your report</h3>
            <p class="contact-review-email">{{index .FormValues "email"}}</p>
            <p><strong>Type</strong>: {{index .FormValues "type"}}</p>
            <p><strong>Subject</strong>: {{index .FormValues "subject"}}</p>
            <form method="POST" action="{{ path "/server/contact" }}">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
                {{range $key, $value := .FormValues}}{{if and (ne $key "form_token") (ne $key "step")}}<input type="hidden" name="{{$key}}" value="{{$value}}">{{end}}{{end}}
                <input type="hidden" name="step" value="confirm">
                <input type="hidden" name="review_token" value="{{.ReviewToken}}">
                <label><input type="checkbox" name="confirmed" value="true" required> This email address is correct, and this is a genuine report, not an advertisement, a solicitation or spam</label>
                <button type="submit" class="search-button">Confirm report</button>
            </form>
            <form method="POST" action="{{ path "/server/contact" }}">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                {{range $key, $value := .FormValues}}{{if ne $key "step"}}<input type="hidden" name="{{$key}}" value="{{$value}}">{{end}}{{end}}
                <input type="hidden" name="step" value="edit">
                <button type="submit" class="btn-secondary">Edit report</button>
            </form>
        </section>
        {{else}}
        <form method="POST" action="{{ path "/server/contact" }}" class="preferences-form">
            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
            <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
            <input type="hidden" name="step" value="submit">
            <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden" aria-hidden="true">
                <label for="website">Leave this field empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>
            <div class="form-group">
                <label class="form-label" for="name">{{ t "contact.label_name" }}</label>
                <input class="form-input" type="text" id="name" name="name" required maxlength="100" value="{{index .FormValues "name"}}">
            </div>
            <div class="form-group">
                <label class="form-label" for="email">{{ t "contact.label_email" }}</label>
                <input class="form-input" type="email" id="email" name="email" required maxlength="254" placeholder="{{ t "contact.placeholder_email" }}" value="{{index .FormValues "email"}}">
            </div>
            <div class="form-group">
                <label class="form-label" for="subject">{{ t "contact.label_subject" }}</label>
                <input class="form-input" aria-describedby="subject-error" aria-invalid="false" type="text" id="subject" name="subject" required maxlength="200" placeholder="{{ t "contact.placeholder_subject" }}" value="{{index .FormValues "subject"}}">
                <p id="subject-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="message">{{ t "contact.label_message" }}</label>
                <textarea class="form-input" aria-describedby="message-error" aria-invalid="false" id="message" name="message" required maxlength="5000" rows="5" placeholder="{{ t "contact.placeholder_message" }}">{{index .FormValues "message"}}</textarea>
                <p id="message-error" class="field-error" role="alert" hidden></p>
            </div>
            <div class="form-group">
                <label class="form-label" for="type">Type</label>
                <select class="form-input" id="type" name="type" required>
                    <option value="abuse"{{if eq (index .FormValues "type") "abuse"}} selected{{end}}>Abuse / terms violation</option>
                    <option value="dmca"{{if eq (index .FormValues "type") "dmca"}} selected{{end}}>DMCA notice</option>
                    <option value="privacy"{{if eq (index .FormValues "type") "privacy"}} selected{{end}}>Privacy request</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="reported_url">Reported URL (required for abuse or DMCA)</label>
                <input class="form-input" type="url" id="reported_url" name="reported_url" maxlength="2048" value="{{index .FormValues "reported_url"}}">
            </div>
            <div class="form-group">
                <label class="form-label" for="reason">Reason (required for abuse)</label>
                <select class="form-input" id="reason" name="reason">
                    <option value="">Select a reason</option>
                    <option value="illegal_content">Illegal content</option>
                    <option value="terms_violation">Terms violation</option>
                    <option value="harassment">Harassment</option>
                    <option value="malware_phishing">Malware or phishing</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="copyrighted_work">Copyrighted work (required for DMCA)</label>
                <textarea class="form-input" id="copyrighted_work" name="copyrighted_work" maxlength="2000" rows="3"></textarea>
            </div>
            <div class="form-group"><label class="form-label"><input type="checkbox" name="good_faith" value="true"> I have a good-faith belief that this use is not authorized by the copyright owner, its agent or the law.</label></div>
            <div class="form-group"><label class="form-label"><input type="checkbox" name="accuracy" value="true"> The information is accurate and, under penalty of perjury, I am the owner or authorized to act for the owner.</label></div>
            <div class="form-group">
                <label class="form-label" for="signature">Signature (required for DMCA)</label>
                <input class="form-input" type="text" id="signature" name="signature" maxlength="100">
            </div>
            <div class="form-group">
                <label class="form-label" for="request_kind">Privacy request kind (required for privacy)</label>
                <select class="form-input" id="request_kind" name="request_kind">
                    <option value="">Select a request</option>
                    <option value="access">Access</option><option value="export">Export</option>
                    <option value="deletion">Deletion</option><option value="correction">Correction</option>
                    <option value="opt_out">Opt out</option><option value="other">Other</option>
                </select>
            </div>
            {{ if eq .CaptchaType "simple" }}
            <div class="form-group">
                <label class="form-label" for="captcha_answer">{{ t "contact.captcha_question" }}: {{ .CaptchaQuestion }}</label>
                <input class="form-input" type="hidden" name="captcha_id" value="{{ .CaptchaID }}">
                <input class="form-input" type="number" id="captcha_answer" name="captcha_answer" required inputmode="numeric">
            </div>
            {{ else if eq .CaptchaType "recaptcha" }}
            <div class="g-recaptcha" data-sitekey="{{ .CaptchaSiteKey }}"></div>
            <script async defer src="https://www.google.com/recaptcha/api.js"></script>
            <noscript>
                <div class="form-group">
                    <label class="form-label" for="captcha_fallback_answer">{{ t "contact.captcha_question" }}: {{ .CaptchaFallbackQuestion }}</label>
                    <input class="form-input" type="hidden" name="captcha_id" value="{{ .CaptchaFallbackID }}">
                    <input class="form-input" type="number" id="captcha_fallback_answer" name="captcha_answer" required inputmode="numeric">
                </div>
            </noscript>
            {{ else if eq .CaptchaType "hcaptcha" }}
            <div class="h-captcha" data-sitekey="{{ .CaptchaSiteKey }}"></div>
            <script async defer src="https://js.hcaptcha.com/1/api.js"></script>
            <noscript>
                <div class="form-group">
                    <label class="form-label" for="captcha_fallback_answer">{{ t "contact.captcha_question" }}: {{ .CaptchaFallbackQuestion }}</label>
                    <input class="form-input" type="hidden" name="captcha_id" value="{{ .CaptchaFallbackID }}">
                    <input class="form-input" type="number" id="captcha_fallback_answer" name="captcha_answer" required inputmode="numeric">
                </div>
            </noscript>
            {{ end }}
            <button type="submit" class="search-button" data-loading-text="{{ t "action.sending" }}">{{ t "contact.submit_message" }}</button>
        </form>
        {{end}}
        {{end}}
        <h2>Security Issues</h2>
        <p>To report a security vulnerability, consult our security policy at <a href="{{ path "/server/security" }}">/server/security</a>.</p>
        <h2>Abuse Reports</h2>
        <p>To report abusive content or a terms violation, choose the type Abuse above. To send a DMCA notice, choose the type DMCA.{{if .AbuseEmail}} Or email <a href="mailto:{{.AbuseEmail}}">{{.AbuseEmail}}</a>.{{end}}</p>
    </div>
</div>
{{end}}
{{end}}
