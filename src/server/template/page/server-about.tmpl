{{define "server-about"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="content">
    <div class="prose">
        <h1>{{ tf "about.page_title" .AppName }}</h1>
        {{if .AppTagline}}<p class="tagline">{{.AppTagline}}</p>{{end}}
        <p>{{ tf "about.intro" .AppName }}</p>

        <h2>{{ t "about.features" }}</h2>
        <ul>
            <li><strong>{{ t "about.feature_privacy_label" }}</strong> — {{ t "about.feature_privacy_desc" }}</li>
            <li><strong>{{ t "about.feature_multi_engine" }}</strong> — {{ t "about.feature_multi_engine_desc" }}</li>
            <li><strong>{{ t "about.feature_streaming" }}</strong> — {{ t "about.feature_streaming_desc" }}</li>
            <li><strong>{{ t "about.feature_thumbnail_proxy" }}</strong> — {{ t "about.feature_thumbnail_proxy_desc" }}</li>
            <li><strong>{{ t "about.feature_preview" }}</strong> — {{ t "about.feature_preview_desc" }}</li>
            <li><strong>{{ t "about.feature_client_prefs" }}</strong> — {{ t "about.feature_client_prefs_desc" }}</li>
            <li><strong>{{ t "about.feature_tor_label" }}</strong> — {{ t "about.feature_tor_desc" }}</li>
            <li><strong>{{ t "about.feature_geo" }}</strong> — {{ t "about.feature_geo_desc" }}</li>
            <li><strong>{{ t "about.feature_binary" }}</strong> — {{ t "about.feature_binary_desc" }}</li>
        </ul>

        <h2>{{ t "about.version_info" }}</h2>
        <p><strong>{{ t "about.version_label" }}:</strong> <code>{{.Version}}</code></p>
        <p><strong>{{ t "about.build_label" }}:</strong> {{.BuildDateTime}}</p>

        <h2>{{ t "about.links" }}</h2>
        <ul>
            <li><a href="https://github.com/apimgr/vidveil" target="_blank" rel="noopener">{{ t "about.link_source" }}</a> — {{ t "about.link_source_desc" }}</li>
            <li><a href="https://x.scour.li" target="_blank" rel="noopener">{{ t "about.link_official" }}</a></li>
            <li><a href="/server/help">{{ t "about.link_help" }}</a></li>
            <li><a href="/server/privacy">{{ t "about.link_privacy" }}</a></li>
        </ul>
    </div>
</div>
{{end}}
