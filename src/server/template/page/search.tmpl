{{define "search"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
</head>
<body class="search-page">
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    {{template "public/header" .}}
    <main class="results" id="main-content" role="main" aria-label="{{ t "a11y.search_results" }}">
        {{/* Search header with inline search and collapsible filters */}}
        <div class="search-header" id="search-header">
            <form action="/search" method="get" class="search-form search-form--inline" role="search" aria-label="{{ t "a11y.refine_search" }}" data-action="search-submit">
                <div class="search-wrapper search-wrapper--compact">
                    <input type="text"
                           id="results-search-input"
                           name="q"
                           value="{{.Query}}"
                           placeholder="{{ t "a11y.refine_search" }}..."
                           autocomplete="off"
                           class="search-input--compact"
                           aria-label="{{ t "a11y.search_query" }}"
                           aria-autocomplete="list"
                           aria-controls="autocomplete-dropdown-results">
                    <div id="autocomplete-dropdown-results"
                         class="autocomplete-dropdown"
                         role="listbox"
                         aria-label="{{ t "a11y.search_suggestions" }}"
                         hidden></div>
                    <button type="submit" class="search-btn--compact" aria-label="{{ t "search.button" }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                    </button>
                </div>
            </form>
            {{template "public/filters" (dict "ShowEngines" false "Compact" true)}}
        </div>

        {{/* Hidden by default: the server already rendered results below, so the
             spinner only appears if JS later fetches more (infinite scroll). */}}
        <div class="initial-loading hidden" id="initial-loading" role="status" aria-live="polite">
            <div class="spinner large" aria-hidden="true"></div>
            <p id="loading-text">{{ t "search.connecting_engines" }}</p>
        </div>
        <p class="meta" id="search-meta" data-query="{{.Query}}" aria-live="polite"><span id="result-count">{{len .Results}}</span> results <span id="search-time-container">in {{.SearchTime}}ms</span></p>
        <div class="status-bar hidden" id="status-bar">
            <span id="status-text">{{ t "search.connecting" }}</span>
            <span id="engine-status"></span>
        </div>

        {{if .SpellSuggestion}}
        <p class="spell-suggestion" id="spell-suggestion">{{ t "search.did_you_mean" }} <a href="/search?q={{urlquery .SpellSuggestion}}{{if .EnginesParam}}&amp;engines={{urlquery .EnginesParam}}{{end}}">{{.SpellSuggestion}}</a>?</p>
        {{end}}

        {{if .RelatedSearches}}
        <nav class="related-searches" id="related-searches" role="navigation" aria-label="{{ t "a11y.related_searches" }}">
            <span class="related-label">{{ t "search.related_searches" }}</span>
            <div class="related-tags" id="related-tags">
                {{range $i, $term := .RelatedSearches}}
                <a class="related-tag{{if ge $i 6}} related-tag--hidden{{end}}" href="/search?q={{urlquery $term}}{{if $.EnginesParam}}&amp;engines={{urlquery $.EnginesParam}}{{end}}" aria-label="{{tf "a11y.search_for" $term}}">
                    <svg class="related-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <span>{{$term}}</span>
                </a>
                {{end}}
            </div>
        </nav>
        {{end}}

        {{/* Server-rendered results — visible for every client, including no-JS.
             With JS, app.js hydrates richer cards in place from the inline JSON
             payload below (single server search, no second request). SSE is used
             only for infinite scroll beyond this first page. */}}
        <div class="video-grid" id="video-grid" role="list" aria-label="{{ t "a11y.video_results" }}">
            {{range .Results}}
            <div class="video-card" role="listitem" data-source="{{.Source}}">
                <a href="{{.URL}}" {{if $.OpenNewTab}}target="_blank" {{end}}rel="noopener noreferrer nofollow" aria-label="{{.Title}} - {{.Duration}} - {{.Source}}">
                    <img src="/api/v1/proxy/thumbnails?url={{urlquery .Thumbnail}}" alt="{{tf "a11y.thumbnail_for" .Title}}" loading="lazy">
                    <div class="video-info">
                        <h3 class="video-title">{{.Title}}</h3>
                        <p class="video-meta">
                            <span class="duration">{{.Duration}}</span>
                            {{if .Views}}<span class="views">{{.Views}} {{ t "time.views" }}</span>{{end}}
                        </p>
                        <p class="video-source">{{.Source}}</p>
                    </div>
                </a>
            </div>
            {{end}}
        </div>
        <div class="loading hidden" id="loading" role="status" aria-live="polite"><div class="spinner" aria-hidden="true"></div><span>{{ t "search.loading_more" }}</span></div>

        {{/* Server-driven pagination (IDEA.md "Search behavior"/"Search Settings"):
             the server decides page size via the results_per_page cookie, not JS.
             This link works with JS disabled. When the visitor's preference is
             "Infinite scroll", app.js hides the link and auto-clicks it via
             IntersectionObserver instead — the server still controls page size
             and content either way. */}}
        {{if .HasMore}}
        <nav class="load-more-container" id="load-more-container" data-infinite-scroll="{{.InfiniteScroll}}" aria-label="{{ t "a11y.load_more_results" }}">
            <a href="/search?q={{urlquery .SearchQuery}}{{if .EnginesParam}}&amp;engines={{urlquery .EnginesParam}}{{end}}&amp;page={{.NextPage}}" class="btn btn--secondary load-more-link" id="load-more-link" rel="next">{{ t "search.load_more" }}</a>
        </nav>
        {{end}}

        {{/* Inline JSON payload of the server-computed first page. app.js reads this
             (never a second /api/v1/search) to build enhanced cards under strict CSP. */}}
        <script type="application/json" id="search-results-data">{{.ResultsJSON}}</script>
    </main>
    {{template "public/footer" .}}
    {{template "public/scripts" .}}
</body>
</html>
{{end}}
