{{define "content-restricted"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="{{ asset "/static/css/common.css" }}">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#128269;</text></svg>">
</head>
<body>
    <div class="age-gate">
        <div class="age-gate-box">
            <div class="warning-icon">&#127760;</div>
            <h1>{{ t "content_restricted.title" }}</h1>
            {{if .Region}}
            <p class="region-notice">{{ t "content_blocked.region_notice" }} <strong>{{.Region}}</strong></p>
            {{end}}
            <p>{{.Message}}</p>
            <p>{{ t "content_restricted.acknowledge_intro" }}</p>
            <ul class="legal-list">
                <li>{{ t "content_restricted.ack_1" }}</li>
                <li>{{ t "content_restricted.ack_2" }}</li>
                <li>{{ t "content_restricted.ack_3" }}</li>
            </ul>
            <div class="age-buttons">
                <form method="POST" action="/content-restricted" class="d-inline">
                    <input type="hidden" name="redirect" value="{{.Redirect}}">
                    {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                    <button type="submit" class="btn-yes">{{ t "content_restricted.proceed" }}</button>
                </form>
                <button type="button" class="btn-no" data-action="leave-site">{{ t "age_verify.exit" }}</button>
            </div>
            <p class="legal">
                {{ t "content_restricted.legal" }}
            </p>
        </div>
    </div>
    {{template "public/scripts" .}}
</body>
</html>
{{end}}
