{{define "public/site-banner"}}
{{/* Site Banner per AI.md PART 16 "Site Banner" - server filters to active,
     undismissed announcements (see activeAnnouncements()); rendered
     immediately after <body>/skip-link, before header/nav/main, so there is
     no layout shift and no JS dependency. Dismissal is a zero-JS form POST
     to /announcements/dismiss; app.js only removes the reload. */}}
{{ range .Announcements }}
<div class="site-banner site-banner-{{.Type}}" role="{{ if or (eq .Type "warning") (eq .Type "error") }}alert{{ else }}status{{ end }}" data-announcement-id="{{.ID}}">
    <span class="site-banner-icon" aria-hidden="true">{{ if eq .Type "error" }}&#10060;{{ else if eq .Type "warning" }}&#9888;{{ else if eq .Type "success" }}&#9989;{{ else }}&#8505;{{ end }}</span>
    <span class="site-banner-text">{{.Message}}</span>
    {{ if .Dismissible }}
    <form method="post" action="/announcements/dismiss" class="site-banner-dismiss">
        {{ if $.CSRFToken }}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{ end }}
        <input type="hidden" name="id" value="{{.ID}}">
        <input type="hidden" name="return_to" value="{{$.CurrentPath}}">
        <button type="submit" class="site-banner-close" aria-label="{{ t "banner.dismiss_label" }}">&times;</button>
    </form>
    {{ end }}
</div>
{{ end }}
{{end}}
