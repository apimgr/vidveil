{{define "owner-tokens"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
    <link rel="stylesheet" href="{{asset "/static/css/owner-tokens.css"}}">
</head>
<body>
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    {{template "public/site-banner" .}}
    {{template "public/header" .}}
    {{template "public/nav" .}}
    <main class="owner-tokens-page" id="main-content" role="main">
        <header class="owner-tokens-heading">
            <h1>{{ t "owner_tokens.title" }}</h1>
            <a href="/server/preferences">{{ t "owner_tokens.return_preferences" }}</a>
        </header>

        {{if .TokensEnabled}}
        <section aria-labelledby="primary-token-heading">
            <h2 id="primary-token-heading">{{ t "owner_tokens.primary_token" }}</h2>
            <p><code>tok_••••••••••••••••••••••••{{.PrimaryToken.Suffix}}</code></p>
            <p>{{ t "owner_tokens.created_at" }}: <time>{{.PrimaryToken.Created}}</time> · {{ t "owner_tokens.last_used" }}: {{if .PrimaryToken.LastUsed}}<time>{{.PrimaryToken.LastUsed}}</time>{{else}}{{ t "owner_tokens.never_used" }}{{end}}</p>
            <div class="owner-token-actions">
                <form method="post" action="/server/preferences/token/reveal">
                    {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                    <button type="submit" class="btn-secondary">{{ t "owner_tokens.reveal_primary" }}</button>
                </form>
                <form method="post" action="/server/preferences/token/rotate">
                    {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                    <label><input type="checkbox" name="confirm" value="rotate" required> {{ t "owner_tokens.rotate_warning" }}</label>
                    <button type="submit" class="btn-danger">{{ t "owner_tokens.rotate_primary" }}</button>
                </form>
            </div>
        </section>

        <section aria-labelledby="linked-token-heading">
            <h2 id="linked-token-heading">{{ t "owner_tokens.linked_tokens" }}</h2>
            {{if .LinkedTokens}}
            <div class="owner-token-list">
                {{range .LinkedTokens}}
                <article class="owner-token-card">
                    <h3>{{.Name}}</h3>
                    <p><code>tok_••••••••••••••••••••••••{{.Suffix}}</code> · <span class="token-status token-status-{{.Status}}">{{if eq .Status "active"}}{{ t "owner_tokens.status_active" }}{{else if eq .Status "expired"}}{{ t "owner_tokens.status_expired" }}{{else}}{{ t "owner_tokens.status_revoked" }}{{end}}</span></p>
                    <p>{{ t "owner_tokens.created_at" }}: <time>{{.Created}}</time> · {{ t "owner_tokens.last_used" }}: {{if .LastUsed}}<time>{{.LastUsed}}</time>{{else}}{{ t "owner_tokens.never_used" }}{{end}} · {{ t "owner_tokens.expires" }}: {{if eq .Expires "never"}}{{ t "owner_tokens.never" }}{{else}}{{.Expires}}{{end}}</p>
                    {{if ne .Status "revoked"}}
                    <div class="owner-token-actions">
                        <form method="post" action="/server/preferences/tokens/{{.ID}}/reveal">
                            {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}
                            <button type="submit" class="btn-secondary">{{ t "owner_tokens.reveal" }}</button>
                        </form>
                        <form method="post" action="/server/preferences/tokens/{{.ID}}/rotate">
                            {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}
                            <button type="submit" class="btn-secondary">{{ t "owner_tokens.rotate" }}</button>
                        </form>
                        <form method="post" action="/server/preferences/tokens/{{.ID}}/update">
                            {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}
                            <label>{{ t "owner_tokens.name" }} <input name="name" value="{{.Name}}" required minlength="1" maxlength="64"></label>
                            <label>{{ t "owner_tokens.expiry" }}
                                <select name="expires_preset">
                                    <option value="never"{{if eq .Expires "never"}} selected{{end}}>{{ t "owner_tokens.never" }}</option>
                                    <option value="7d"{{if eq .Expires "7d"}} selected{{end}}>{{ t "owner_tokens.days_7" }}</option>
                                    <option value="30d"{{if eq .Expires "30d"}} selected{{end}}>{{ t "owner_tokens.days_30" }}</option>
                                    <option value="90d"{{if eq .Expires "90d"}} selected{{end}}>{{ t "owner_tokens.days_90" }}</option>
                                    <option value="1y"{{if eq .Expires "1y"}} selected{{end}}>{{ t "owner_tokens.year_1" }}</option>
                                    <option value="custom"{{if ne .Expires "never"}} selected{{end}}>{{ t "owner_tokens.custom_expiry" }}</option>
                                </select>
                            </label>
                            <label>{{ t "owner_tokens.custom_expiry" }} <input type="date" name="expires_date" value="{{if ne .Expires "never"}}{{.Expires}}{{end}}"></label>
                            <button type="submit" class="btn-secondary">{{ t "owner_tokens.update" }}</button>
                        </form>
                        {{if eq .Status "active"}}
                        <form method="post" action="/server/preferences/tokens/{{.ID}}/revoke">
                            {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}
                            <button type="submit" class="btn-danger">{{ t "owner_tokens.revoke" }}</button>
                        </form>
                        {{end}}
                    </div>
                    {{end}}
                </article>
                {{end}}
            </div>
            {{else}}
            <p>{{ t "owner_tokens.no_linked_tokens" }}</p>
            {{end}}
        </section>

        <section aria-labelledby="create-linked-token-heading">
            <h2 id="create-linked-token-heading">{{ t "owner_tokens.create_linked" }}</h2>
            <form method="post" action="/server/preferences/tokens" class="owner-token-create-form">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <label>{{ t "owner_tokens.name" }} <input name="name" required minlength="1" maxlength="64"></label>
                <label>{{ t "owner_tokens.expiry" }}
                    <select name="expires_preset">
                        <option value="never">{{ t "owner_tokens.never" }}</option>
                        <option value="7d">{{ t "owner_tokens.days_7" }}</option>
                        <option value="30d">{{ t "owner_tokens.days_30" }}</option>
                        <option value="90d">{{ t "owner_tokens.days_90" }}</option>
                        <option value="1y">{{ t "owner_tokens.year_1" }}</option>
                        <option value="custom">{{ t "owner_tokens.custom_expiry" }}</option>
                    </select>
                </label>
                <label>{{ t "owner_tokens.custom_expiry" }} <input type="date" name="expires_date"></label>
                <button type="submit" class="btn-secondary">{{ t "owner_tokens.create_linked" }}</button>
            </form>
        </section>
        {{else}}
        <section aria-labelledby="restore-token-heading">
            <h2 id="restore-token-heading">{{ t "owner_tokens.restore" }}</h2>
            <p>{{ t "owner_tokens.restore_description" }}</p>
            <form method="post" action="/server/preferences/token/restore" class="owner-token-create-form">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <label for="owner-token-restore">{{ t "owner_tokens.primary_token" }}</label>
                <input id="owner-token-restore" name="token" type="password" autocomplete="off" required>
                <button type="submit" class="btn-secondary">{{ t "owner_tokens.restore" }}</button>
            </form>
        </section>
        {{end}}
    </main>
    {{template "public/footer" .}}
    {{template "public/scripts" .}}
</body>
</html>
{{end}}
