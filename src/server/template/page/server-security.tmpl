{{define "server-security"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="container container-md">
        <header class="page-header">
            <h1 class="page-title">{{ t "security.title" }}</h1>
            <p class="page-lead">{{ t "security.intro" }}</p>
        </header>

        <section class="section-card" aria-labelledby="security-channels-heading">
        <h2 id="security-channels-heading">{{ t "security.channels_title" }}</h2>
        <p>{{ t "security.channels_intro" }}</p>
        <ul>
            {{range .Contacts}}
            <li><a href="{{.}}">{{.}}</a></li>
            {{end}}
        </ul>

        {{if .Expires}}
        <p><strong>{{ t "security.expires_label" }}</strong> {{.Expires}}</p>
        {{end}}

        {{if .HasPGPKey}}
        <p>{{ t "security.pgp_intro" }} <a href="{{ path "/.well-known/pgp-key.asc" }}">{{ t "security.pgp_link_text" }}</a>.</p>
        {{end}}
        </section>

        <section class="section-card" aria-labelledby="security-report-heading">
        <h2 id="security-report-heading">{{ t "security.how_to_report_title" }}</h2>
        <p>{{tf "security.how_to_report_body" "days" .DisclosureDays}}</p>
        {{if .ContactEnabled}}
        {{if .SecurityContactURL}}
        <p><a href="{{.SecurityContactURL}}">{{ t "contact.submit_security_report" }}</a></p>
        {{end}}
        {{if .ContactReportURL}}
        <p>{{ t "security.contact_other_reports" }} <a href="{{.ContactReportURL}}">{{ t "security.contact_report_form" }}</a>.</p>
        {{end}}
        {{end}}
        </section>

        <section class="section-card" aria-labelledby="security-more-heading">
        <h2 id="security-more-heading">{{ t "security.more_info_title" }}</h2>
        <ul>
            <li><a href="{{ path "/server/security/policy" }}">{{ t "security.policy_link" }}</a></li>
            <li><a href="{{ path "/server/security/thanks" }}">{{ t "security.thanks_link" }}</a></li>
            <li><a href="{{ path "/.well-known/security.txt" }}">{{ t "security.txt_link" }}</a> {{ t "security.txt_link_suffix" }}</li>
        </ul>
        </section>
</div>
{{end}}
