{{define "server-security-thanks"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="container container-md">
        <header class="page-header">
            <nav class="breadcrumb" aria-label="{{ t "a11y.breadcrumb" }}"><a href="{{ path "/server/security" }}">{{ t "security.title" }}</a></nav>
            <h1 class="page-title">{{ t "security.thanks_title" }}</h1>
            <p class="page-lead">{{ t "security.thanks_intro" }}</p>
        </header>

        <section class="section-card" aria-labelledby="security-thanks-heading">
        <h2 id="security-thanks-heading">{{ t "security.more_info_title" }}</h2>
        {{if .Credits}}
        <ul>
            {{range .Credits}}
            <li>{{.Name}} ({{.Year}})</li>
            {{end}}
        </ul>
        {{else}}
        <p>{{ t "security.thanks_empty" }}</p>
        {{end}}
        </section>

        <p><a href="{{ path "/server/security" }}">{{ t "security.back_to_security" }}</a></p>
</div>
{{end}}
