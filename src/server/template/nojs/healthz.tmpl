{{define "healthz-nojs"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>{{template "public/head" .}}</head>
<body>
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    <a href="#navigation" class="skip-link">{{ t "a11y.skip_to_nav" }}</a>
    {{ trackingNoScript }}
    {{template "public/site-banner" .}}
    {{template "public/header" .}}
    <main id="main-content" role="main">
        <div class="container container-md">
            <header class="page-header">
                <h1 class="page-title">{{.ProjectName}}</h1>
                <p class="page-lead">{{.ProjectTagline}} {{.ProjectDescription}}</p>
            </header>
            <section class="section-card" aria-labelledby="health-status-title">
                <h2 id="health-status-title">{{ t "healthz.system_health" }}</h2>
                <div class="status-banner status-{{.StatusClass}}" role="status" aria-live="polite">{{.StatusIcon}} {{.StatusText}}</div>
                {{if .Maintenance}}
                <h3>{{ t "healthz.maintenance_title" }}</h3>
                <p>{{.MaintenanceMessage}}</p>
                <p>{{ t "healthz.maintenance_reason" }}: <code>{{.Maintenance.Reason}}</code></p>
                {{if .Maintenance.SelfHealing.Enabled}}
                <p>{{ t "healthz.maintenance_attempts" }}: {{.Maintenance.SelfHealing.Attempts}}. {{ t "healthz.maintenance_recovery" }}: <time datetime="{{.Maintenance.SelfHealing.NextAttempt}}">{{.Maintenance.SelfHealing.NextAttempt}}</time>.</p>
                {{else}}
                <p>{{ t "healthz.maintenance_manual" }}</p>
                {{end}}
                {{end}}
            </section>
            <section class="section-card" aria-labelledby="health-version-title">
                <h2 id="health-version-title">{{ t "healthz.version_title" }}</h2>
                <dl><dt>{{ t "healthz.version_label" }}</dt><dd><code>{{.Version}}</code></dd><dt>{{ t "healthz.go_version_label" }}</dt><dd><code>{{.GoVersion}}</code></dd><dt>{{ t "healthz.build_label" }}</dt><dd><code>{{.BuildCommit}}</code> ({{.BuildDate}})</dd></dl>
            </section>
            <section class="section-card" aria-labelledby="health-runtime-title">
                <h2 id="health-runtime-title">{{ t "healthz.runtime_title" }}</h2>
                <dl><dt>{{ t "healthz.uptime_label" }}</dt><dd>{{.Uptime}}</dd><dt>{{ t "healthz.mode_label" }}</dt><dd><span class="badge badge-{{.Mode}}">{{.ModeDisplay}}</span></dd></dl>
            </section>
            <section class="section-card" aria-labelledby="health-features-title">
                <h2 id="health-features-title">{{ t "healthz.features_title" }}</h2>
                <ul>
                    <li>{{ t "healthz.tor_label" }}: <span class="badge status-{{if eq .Features.TorStatus "unavailable"}}degraded{{else if eq .Features.TorStatus "disabled"}}disabled{{else}}ok{{end}}">{{.Features.TorStatus}}</span>{{if .Features.TorOnionAddr}} — <code>{{.Features.TorOnionAddr}}</code>{{end}}</li>
                    <li>{{ t "healthz.i2p_label" }}: <span class="badge status-{{if eq .Features.I2PStatus "unavailable"}}degraded{{else if eq .Features.I2PStatus "disabled"}}disabled{{else}}ok{{end}}">{{.Features.I2PStatus}}</span>{{if .Features.I2PAddress}} — <code>{{.Features.I2PAddress}}</code>{{end}}</li>
                    <li>{{ t "healthz.geoip_label" }}: <span class="badge {{if .Features.GeoIP}}badge-success{{else}}badge-warning{{end}}">{{if .Features.GeoIP}}{{ t "healthz.enabled" }}{{else}}{{ t "healthz.disabled" }}{{end}}</span></li>
                </ul>
            </section>
            <section class="section-card" aria-labelledby="health-checks-title">
                <h2 id="health-checks-title">{{ t "healthz.component_status_title" }}</h2>
                <dl>
                    <dt>{{ t "healthz.database_label" }}</dt><dd><span class="badge status-{{.Checks.Database}}">{{.Checks.DatabaseText}}</span></dd>
                    <dt>{{ t "healthz.cache_label" }}</dt><dd><span class="badge status-{{.Checks.Cache}}">{{.Checks.CacheText}}</span></dd>
                    <dt>{{ t "healthz.disk_label" }}</dt><dd><span class="badge status-{{.Checks.Disk}}">{{.Checks.DiskText}}</span></dd>
                    <dt>{{ t "healthz.scheduler_label" }}</dt><dd><span class="badge status-{{.Checks.Scheduler}}">{{.Checks.SchedulerText}}</span></dd>
                    {{if .Checks.Tor}}<dt>{{ t "healthz.tor_label" }}</dt><dd><span class="badge status-{{.Checks.Tor}}">{{.Checks.TorText}}</span></dd>{{end}}
                    {{if .Checks.I2P}}<dt>{{ t "healthz.i2p_label" }}</dt><dd><span class="badge status-{{.Checks.I2P}}">{{.Checks.I2PText}}</span></dd>{{end}}
                    {{range .Checks.Datasets}}<dt>{{.Label}}</dt><dd><span class="badge status-{{.Status}}">{{.StatusText}}</span></dd>{{end}}
                </dl>
            </section>
            <section class="section-card" aria-labelledby="health-statistics-title">
                <h2 id="health-statistics-title">{{ t "healthz.statistics_title" }}</h2>
                <dl><dt>{{ t "healthz.requests_total_label" }}</dt><dd>{{.Stats.RequestsTotal}}</dd><dt>{{ t "healthz.requests_24h_label" }}</dt><dd>{{.Stats.Requests24h}}</dd><dt>{{ t "healthz.active_connections_label" }}</dt><dd>{{.Stats.ActiveConnections}}</dd></dl>
            </section>
            <section class="section-card" aria-labelledby="health-checked-title">
                <h2 id="health-checked-title">{{ t "healthz.last_checked" }}</h2>
                <p><time datetime="{{.Timestamp}}">{{.TimestampDisplay}}</time></p>
            </section>
        </div>
    </main>
    {{template "public/footer" .}}
</body>
</html>
{{end}}
