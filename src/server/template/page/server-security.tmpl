{{define "server-security"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="content">
    <div class="prose">
        <h1>{{ t "security.title" }}</h1>

        <p>{{ t "security.intro" }}</p>

        <h2>{{ t "security.channels_title" }}</h2>
        <p>{{ t "security.channels_intro" }}</p>
        <ul>
            {{range .Contacts}}
            <li><a href="{{.}}">{{.}}</a></li>
            {{end}}
        </ul>

        {{if .Expires}}
        <p><strong>{{ t "security.expires_label" }}</strong> {{.Expires}}</p>
        {{end}}

        {{if .HasPGPKey}}
        <p>{{ t "security.pgp_intro" }} <a href="/.well-known/pgp-key.asc">{{ t "security.pgp_link_text" }}</a>.</p>
        {{end}}

        <h2>{{ t "security.how_to_report_title" }}</h2>
        <p>{{tf "security.how_to_report_body" .DisclosureDays}}</p>

        <h2>{{ t "security.more_info_title" }}</h2>
        <ul>
            <li><a href="/server/security/policy">{{ t "security.policy_link" }}</a></li>
            <li><a href="/server/security/thanks">{{ t "security.thanks_link" }}</a></li>
            <li><a href="/.well-known/security.txt">{{ t "security.txt_link" }}</a> {{ t "security.txt_link_suffix" }}</li>
        </ul>
    </div>
</div>
{{end}}
