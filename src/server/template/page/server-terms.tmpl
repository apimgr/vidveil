{{define "server-terms"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="content">
    <div class="prose">
        <h1>{{ t "terms.title" }}</h1>
        <p class="last-updated">{{ tf "terms.last_updated" "date" .BuildDateTime }}</p>
        {{ if .PageContent }}
        {{ .PageContent | markdownToHTML }}
        {{ else }}

        <h2>{{ t "terms.acceptance" }}</h2>
        <p>{{ tf "terms.acceptance_body" "app_name" .AppName }}</p>

        <h2>{{ t "terms.eligibility" }}</h2>
        <p>{{ tf "terms.eligibility_body" "app_name" .AppName }}</p>

        <h2>{{ t "terms.acceptable_use" }}</h2>
        <p>{{ tf "terms.acceptable_use_intro" "app_name" .AppName }}</p>
        <ul>
            <li>{{ t "terms.rule_illegal_content" }}</li>
            <li>{{ t "terms.rule_circumvent" }}</li>
            <li>{{ t "terms.rule_overload" }}</li>
            <li>{{ t "terms.rule_probe" }}</li>
            <li>{{ t "terms.rule_automation" }}</li>
        </ul>

        <h2>{{ t "terms.third_party" }}</h2>
        <p>{{ tf "terms.third_party_body" "app_name" .AppName }}</p>

        <h2>{{ t "terms.no_warranty" }}</h2>
        <p>{{ t "terms.no_warranty_body" }}</p>

        <h2>{{ t "terms.liability" }}</h2>
        <p>{{ tf "terms.liability_body" "app_name" .AppName }}</p>

        <h2>{{ t "terms.changes" }}</h2>
        <p>{{ t "terms.changes_body" }}</p>

        <h2>{{ t "terms.governing_law" }}</h2>
        <p>{{ t "terms.governing_law_body" }}</p>

        <h2>{{ t "terms.questions" }}</h2>
        <p>{{ t "terms.questions_prefix" }} <a href="/server/contact">{{ t "terms.contact_link" }}</a>.</p>
        {{ end }}
    </div>
</div>
{{end}}
