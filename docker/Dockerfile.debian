# =============================================================================
# Build Stage - Compile Go binary
# =============================================================================
FROM casjaysdev/go:latest AS builder

RUN apk add --no-cache git bash

ARG TARGETARCH
ARG VERSION=dev
ARG BUILD_EPOCH
ARG COMMIT_ID
ARG OFFICIAL_SITE

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go generate ./src/swagger
RUN if [ -f site.txt ]; then OFFICIAL_SITE_VALUE="$(cat site.txt)"; else OFFICIAL_SITE_VALUE="${OFFICIAL_SITE:-}"; fi; \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -trimpath -buildvcs=false \
    -ldflags "-s -w -X 'main.Version=${VERSION}' -X 'main.CommitID=${COMMIT_ID}' -X 'main.BuildEpoch=${BUILD_EPOCH}' -X 'main.OfficialSite=${OFFICIAL_SITE_VALUE}'" \
    -o /app/binary/vidveil ./src

# =============================================================================
# Runtime Stage - All-in-one Debian image
# =============================================================================
FROM debian:trixie-slim

ARG VERSION=dev
ARG BUILD_DATE
ARG COMMIT_ID

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        i2pd \
        tini \
        tor \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/binary/vidveil /usr/local/bin/vidveil
COPY docker/rootfs/ /
COPY docker/Dockerfile.debian /root/Dockerfile
RUN chmod 755 /usr/local/bin/*

ENV TZ=America/New_York \
    VIDVEIL_SERVER_I2P_BOOTSTRAP_TIMEOUT=10m \
    DATABASE_DIR=/data/db/sqlite

EXPOSE 80
STOPSIGNAL SIGRTMIN+3
HEALTHCHECK --start-period=10m --interval=5m --timeout=15s --retries=3 \
    CMD /usr/local/bin/vidveil --status || exit 1
ENTRYPOINT ["tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh"]
