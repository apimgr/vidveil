{{define "owner-tokens"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
    <link rel="stylesheet" href="{{asset "/static/css/owner-tokens.css"}}">
</head>
<body>
    {{ trackingNoScript }}
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    {{template "public/site-banner" .}}
    {{template "public/header" .}}
    {{template "public/nav" .}}
    <main class="owner-tokens-page" id="main-content" role="main">
        <header class="owner-tokens-heading">
            <a href="{{.PathPrefix}}/server/preferences">{{ t "owner_tokens.preferences" }}</a>
            <h1>{{ t "owner_tokens.title" }}</h1>
        </header>
        {{if .Notice}}<div class="owner-token-notice toast toast-success show" role="status" aria-live="polite" data-toast-message>{{.Notice}}</div>{{end}}
        {{if .TokensEnabled}}
        <div class="owner-tokens-layout">
                <section class="section-card owner-token-primary-card" id="primary" data-token-card aria-labelledby="primary-token-heading">
                    <h2 id="primary-token-heading">{{ t "owner_tokens.primary_token" }}</h2>
                    <p><span class="token-status token-status-active">{{ t "owner_tokens.status_active" }}</span></p>
                    <p><code class="copy-value" data-owner-token-value>{{if .PrimaryToken.Revealed}}{{.PrimaryToken.Revealed}}{{else}}tok_••••••••••••••••••••••••{{.PrimaryToken.Suffix}}{{end}}</code></p>
                    <p>{{ t "owner_tokens.primary_help" }}</p>
                    {{if .PrimaryToken.Revealed}}
                    <p><button type="button" class="btn-secondary" data-copy-owner-token data-copy-success="{{ t "owner_tokens.copy_success" }}" data-copy-failed="{{ t "owner_tokens.copy_failed" }}">{{ t "owner_tokens.copy" }}</button> <span role="status" aria-live="polite"></span></p>
                    <p>{{ t "owner_tokens.shown_once" }}</p>
                    {{end}}
                    <div class="owner-token-actions">
                        {{if not .PrimaryToken.Revealed}}
                        <form method="post" action="{{$.PathPrefix}}/server/preferences/token/reveal">
                            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                            <button type="submit" class="btn-secondary">{{ t "owner_tokens.reveal" }}</button>
                        </form>
                        {{end}}
                        <details class="owner-token-confirm">
                            <summary class="btn-danger">{{ t "owner_tokens.rotate_primary" }}</summary>
                            <form method="post" action="{{$.PathPrefix}}/server/preferences/token/rotate">
                                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                                <p>{{ t "owner_tokens.rotate_warning" }}</p>
                                <button type="submit" name="confirm" value="rotate" class="btn-danger">{{ t "owner_tokens.rotate_primary" }}</button>
                            </form>
                        </details>
                    </div>
                </section>
                <section class="section-card owner-token-create-card" aria-labelledby="create-linked-token-heading">
                    <h2 id="create-linked-token-heading">{{ t "owner_tokens.create_linked" }}</h2>
                    <form method="post" action="{{$.PathPrefix}}/server/preferences/tokens" class="owner-token-create-form">
                        {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                        <div class="owner-token-fields">
                            <div class="owner-token-field">
                                <label>{{ t "owner_tokens.name" }} <input name="name" required minlength="1" maxlength="64" aria-describedby="owner-token-name-help"></label>
                                <small id="owner-token-name-help">{{ t "owner_tokens.create_name_help" }}</small>
                            </div>
                            <label>{{ t "owner_tokens.expiry" }}
                                <select name="expires_preset">
                                    <option value="never">{{ t "owner_tokens.never" }}</option>
                                    <option value="7d">{{ t "owner_tokens.days_7" }}</option>
                                    <option value="30d">{{ t "owner_tokens.days_30" }}</option>
                                    <option value="90d">{{ t "owner_tokens.days_90" }}</option>
                                    <option value="1y">{{ t "owner_tokens.year_1" }}</option>
                                    <option value="custom">{{ t "owner_tokens.custom_date" }}</option>
                                </select>
                            </label>
                        </div>
                        <details class="owner-token-custom-date">
                            <summary>{{ t "owner_tokens.custom_date" }}</summary>
                            <label>{{ t "owner_tokens.expires_on" }} <input type="date" name="expires_date"></label>
                        </details>
                        <button type="submit" class="btn-primary">{{ t "owner_tokens.create_token" }}</button>
                    </form>
                </section>
                <section class="section-card owner-token-browser-card" aria-labelledby="owner-browser-heading">
                    <h2 id="owner-browser-heading">{{ t "owner_tokens.this_browser" }}</h2>
                    <p>{{ t "owner_tokens.saved_browser" }}</p>
                    <p>{{ t "owner_tokens.forget_note" }}</p>
                    <details class="owner-token-confirm">
                        <summary class="btn-danger-ghost">{{ t "owner_tokens.forget_saved" }}</summary>
                        <form method="post" action="{{$.PathPrefix}}/server/preferences/token/forget">
                            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                            <button type="submit" class="btn-danger-ghost">{{ t "owner_tokens.forget_saved" }}</button>
                        </form>
                    </details>
                </section>
            <section class="section-card owner-token-linked-section" aria-labelledby="linked-token-heading">
                <h2 id="linked-token-heading">{{ t "owner_tokens.linked_tokens" }} ({{len .LinkedTokens}})</h2>
                {{if .LinkedTokens}}
                <div class="owner-token-list">
                    {{range .LinkedTokens}}
                    <article class="owner-token-card" id="token-{{.ID}}" data-token-card>
                        <header><h3>{{.Name}}</h3><span class="token-status token-status-{{.Status}}">{{if eq .Status "active"}}{{ t "owner_tokens.status_active" }}{{else if eq .Status "expired"}}{{ t "owner_tokens.status_expired" }}{{else}}{{ t "owner_tokens.status_revoked" }}{{end}}</span></header>
                        <p><code class="copy-value" data-owner-token-value>{{if .Revealed}}{{.Revealed}}{{else}}tok_••••••••••••••••••••••••{{.Suffix}}{{end}}</code></p>
                        {{if .Revealed}}
                        <p><button type="button" class="btn-secondary" data-copy-owner-token data-copy-success="{{ t "owner_tokens.copy_success" }}" data-copy-failed="{{ t "owner_tokens.copy_failed" }}">{{ t "owner_tokens.copy" }}</button> <span role="status" aria-live="polite"></span></p>
                        <p>{{ t "owner_tokens.shown_once" }}</p>
                        {{end}}
                        <dl>
                            <dt>{{ t "owner_tokens.created_at" }}</dt><dd><time>{{.Created}}</time></dd>
                            <dt>{{ t "owner_tokens.last_used" }}</dt><dd>{{if .LastUsed}}<time>{{.LastUsed}}</time>{{else}}{{ t "owner_tokens.never_used" }}{{end}}</dd>
                            <dt>{{ t "owner_tokens.expires" }}</dt><dd>{{if eq .Expires "never"}}{{ t "owner_tokens.never" }}{{else}}{{.Expires}}{{end}}</dd>
                        </dl>
                        {{if ne .Status "revoked"}}
                        <footer class="owner-token-actions">
                            {{if not .Revealed}}
                            <form method="post" action="{{.RevealURL}}">
                                {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit" class="btn-secondary">{{ t "owner_tokens.reveal" }}</button>
                            </form>
                            {{end}}
                            <form method="post" action="{{.RotateURL}}">
                                {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit" class="btn-secondary">{{ t "owner_tokens.rotate" }}</button>
                            </form>
                            <details class="owner-token-edit">
                                <summary>{{ t "owner_tokens.edit" }}</summary>
                                <form method="post" action="{{.UpdateURL}}">
                                    {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}
                                    <label>{{ t "owner_tokens.name" }} <input name="name" value="{{.Name}}" required minlength="1" maxlength="64"></label>
                                    <label>{{ t "owner_tokens.expiry" }}
                                        <select name="expires_preset">
                                            <option value="never"{{if eq .Expires "never"}} selected{{end}}>{{ t "owner_tokens.never" }}</option>
                                            <option value="7d">{{ t "owner_tokens.days_7" }}</option><option value="30d">{{ t "owner_tokens.days_30" }}</option><option value="90d">{{ t "owner_tokens.days_90" }}</option><option value="1y">{{ t "owner_tokens.year_1" }}</option><option value="custom"{{if ne .Expires "never"}} selected{{end}}>{{ t "owner_tokens.custom_date" }}</option>
                                        </select>
                                    </label>
                                    <details{{if ne .Expires "never"}} open{{end}}><summary>{{ t "owner_tokens.custom_date" }}</summary><label>{{ t "owner_tokens.expires_on" }} <input type="date" name="expires_date" value="{{if ne .Expires "never"}}{{.Expires}}{{end}}"></label></details>
                                    <button type="submit" class="btn-secondary">{{ t "owner_tokens.save" }}</button>
                                </form>
                            </details>
                            <details class="owner-token-confirm owner-token-revoke">
                                <summary class="btn-danger">{{ t "owner_tokens.revoke" }}</summary>
                                <form method="post" action="{{.RevokeURL}}">
                                    {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit" class="btn-danger">{{ t "owner_tokens.confirm_revoke" }}</button>
                                </form>
                            </details>
                        </footer>
                        {{end}}
                    </article>
                    {{end}}
                </div>
                {{else}}
                <p>{{ t "owner_tokens.no_linked_tokens" }}</p>
                <p>{{ t "owner_tokens.no_linked_tokens_hint" }}</p>
                {{end}}
            </section>
        </div>
        {{else}}
        <section class="section-card owner-token-restore" aria-labelledby="restore-token-heading">
            <h2 id="restore-token-heading">{{ t "owner_tokens.restore_identity" }}</h2>
            <form method="post" action="{{.PathPrefix}}/server/preferences/token/restore" class="owner-token-create-form">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <label for="owner-token-restore">{{ t "owner_tokens.primary_token" }}</label>
                <input id="owner-token-restore" name="token" type="password" autocomplete="off" placeholder="{{ t "owner_tokens.paste_hint" }}" required>
                <button type="submit" class="btn-primary">{{ t "owner_tokens.restore_identity" }}</button>
            </form>
        </section>
        {{end}}
    </main>
    {{template "public/footer" .}}
    {{template "public/scripts" .}}
</body>
</html>
{{end}}
