{{define "nojs/owner-tokens"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
</head>
<body>
    {{ trackingNoScript }}
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    <a href="#navigation" class="skip-link">{{ t "a11y.skip_to_nav" }}</a>
    {{template "public/site-banner" .}}
    {{template "public/header" .}}
    <main id="main-content" role="main">
        <div class="container container-md">
        <header class="page-header">
            <nav class="breadcrumb" aria-label="{{ t "a11y.breadcrumb" }}"><a href="{{.PathPrefix}}/server/preferences">{{ t "owner_tokens.preferences" }}</a></nav>
            <h1 class="page-title">{{ t "owner_tokens.title" }}</h1>
            <p class="page-lead">{{ t "owner_tokens.summary" }}</p>
        </header>
        {{if .Notice}}<div class="alert-success" role="status" aria-live="polite" data-toast-message>{{.Notice}}</div>{{end}}
        {{if .TokensEnabled}}
        <div>
                <section class="section-card" id="primary" data-token-card aria-labelledby="primary-token-heading">
                    <h2 id="primary-token-heading">{{ t "owner_tokens.primary_token" }}</h2>
                    <p><span class="badge badge-success">{{ t "owner_tokens.status_active" }}</span></p>
                    <p><code class="copy-value" data-owner-token-value>{{if .PrimaryToken.Revealed}}{{.PrimaryToken.Revealed}}{{else}}{{.PrimaryToken.TokenPrefix}}••••••••••••••••••••••••{{.PrimaryToken.Suffix}}{{end}}</code></p>
                    <p>{{ t "owner_tokens.primary_help" }}</p>
                    {{if .PrimaryToken.Revealed}}
                    <p></p>
                    <p>{{ t "owner_tokens.shown_once" }}</p>
                    {{end}}
                    <div class="form-actions">
                        {{if not .PrimaryToken.Revealed}}
                        <form method="post" action="{{$.PathPrefix}}/server/preferences/token/reveal">
                            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                            <button type="submit" class="btn btn-secondary">{{ t "owner_tokens.reveal" }}</button>
                        </form>
                        {{end}}
                        <details >
                            <summary class="btn btn-danger">{{ t "owner_tokens.rotate_primary" }}</summary>
                            <form method="post" action="{{$.PathPrefix}}/server/preferences/token/rotate">
                                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                                <p>{{ t "owner_tokens.rotate_warning" }}</p>
                                <button type="submit" name="confirm" value="rotate" class="btn btn-danger">{{ t "owner_tokens.rotate_primary" }}</button>
                            </form>
                        </details>
                    </div>
                </section>
                <section class="section-card" aria-labelledby="create-linked-token-heading">
                    <h2 id="create-linked-token-heading">{{ t "owner_tokens.create_linked" }}</h2>
                    <form method="post" action="{{$.PathPrefix}}/server/preferences/tokens" >
                        {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                        <div >
                            <div class="form-group">
                                <label>{{ t "owner_tokens.name" }} <input class="form-input" name="name" required minlength="1" maxlength="64" aria-describedby="owner-token-name-help"></label>
                                <small id="owner-token-name-help">{{ t "owner_tokens.create_name_help" }}</small>
                            </div>
                            <label>{{ t "owner_tokens.scope" }}
                                <select class="form-input" name="scope">
                                    <option value="read-write" selected>{{ t "owner_tokens.scope_read_write" }}</option>
                                    <option value="read">{{ t "owner_tokens.scope_read" }}</option>
                                </select>
                            </label>
                            <label>{{ t "owner_tokens.expiry" }}
                                <select class="form-input" name="expires_preset">
                                    <option value="never">{{ t "owner_tokens.never" }}</option>
                                    <option value="7d">{{ t "owner_tokens.days_7" }}</option>
                                    <option value="30d">{{ t "owner_tokens.days_30" }}</option>
                                    <option value="90d">{{ t "owner_tokens.days_90" }}</option>
                                    <option value="1y">{{ t "owner_tokens.year_1" }}</option>
                                    <option value="custom">{{ t "owner_tokens.custom_date" }}</option>
                                </select>
                            </label>
                        </div>
                        <details >
                            <summary>{{ t "owner_tokens.custom_date" }}</summary>
                            <label>{{ t "owner_tokens.expires_on" }} <input class="form-input" type="date" name="expires_date"></label>
                        </details>
                        <button type="submit" class="btn btn-primary">{{ t "owner_tokens.create_token" }}</button>
                    </form>
                </section>
                <section class="section-card" aria-labelledby="owner-browser-heading">
                    <h2 id="owner-browser-heading">{{ t "owner_tokens.this_browser" }}</h2>
                    <p>{{ t "owner_tokens.saved_browser" }}</p>
                    <p>{{ t "owner_tokens.forget_note" }}</p>
                    <details >
                        <summary class="btn btn-danger">{{ t "owner_tokens.forget_saved" }}</summary>
                        <form method="post" action="{{$.PathPrefix}}/server/preferences/token/forget">
                            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                            <button type="submit" class="btn btn-danger">{{ t "owner_tokens.forget_saved" }}</button>
                        </form>
                    </details>
                </section>
                <section class="section-card" aria-labelledby="revoke-owner-heading">
                    <h2 id="revoke-owner-heading">{{ t "owner_tokens.revoke_primary_title" }}</h2>
                    <p>{{tf "owner_tokens.revoke_primary_summary" "tokens" .LinkedTokenCount "resources" .ResourceCount}}</p>
                    <details>
                        <summary class="btn btn-danger">{{ t "owner_tokens.revoke_primary" }}</summary>
                        <form method="post" action="{{$.PathPrefix}}/server/preferences/token/revoke">
                            {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                            <p>{{ t "owner_tokens.revoke_primary_warning" }}</p>
                            <label for="revoke-primary-confirm">{{tf "owner_tokens.revoke_primary_confirm" "last4" .PrimaryToken.Suffix}}</label>
                            <input class="form-input" id="revoke-primary-confirm" name="confirm" required minlength="4" maxlength="4" pattern="[A-Za-z0-9]{4}" autocomplete="off" autocapitalize="none" spellcheck="false">
                            <button type="submit" class="btn btn-danger">{{ t "owner_tokens.revoke_primary_submit" }}</button>
                        </form>
                    </details>
                </section>
            <section class="section-card" aria-labelledby="linked-token-heading">
                <h2 id="linked-token-heading">{{ t "owner_tokens.linked_tokens" }} ({{len .LinkedTokens}})</h2>
                {{if .LinkedTokens}}
                <div>
                    {{range .LinkedTokens}}
                    <article  id="token-{{.ID}}" data-token-card>
                        <header><h3>{{.Name}}</h3><span class="badge {{if eq .Status "active"}}badge-success{{else if eq .Status "expired"}}badge-warning{{else}}badge-danger{{end}}">{{if eq .Status "active"}}{{ t "owner_tokens.status_active" }}{{else if eq .Status "expired"}}{{ t "owner_tokens.status_expired" }}{{else}}{{ t "owner_tokens.status_revoked" }}{{end}}</span></header>
                        <p><code class="copy-value" data-owner-token-value>{{if .Revealed}}{{.Revealed}}{{else}}{{.TokenPrefix}}••••••••••••••••••••••••{{.Suffix}}{{end}}</code></p>
                        {{if .Revealed}}
                        <p></p>
                        <p>{{ t "owner_tokens.shown_once" }}</p>
                        {{end}}
                        <dl>
                            <dt>{{ t "owner_tokens.created_at" }}</dt><dd><time>{{.Created}}</time></dd>
                            <dt>{{ t "owner_tokens.scope" }}</dt><dd>{{if eq .Scope "read"}}{{ t "owner_tokens.scope_read" }}{{else}}{{ t "owner_tokens.scope_read_write" }}{{end}}</dd>
                            <dt>{{ t "owner_tokens.last_used" }}</dt><dd>{{if .LastUsed}}<time>{{.LastUsed}}</time>{{else}}{{ t "owner_tokens.never_used" }}{{end}}</dd>
                            <dt>{{ t "owner_tokens.expires" }}</dt><dd>{{if eq .Expires "never"}}{{ t "owner_tokens.never" }}{{else}}{{.Expires}}{{end}}</dd>
                        </dl>
                        {{if ne .Status "revoked"}}
                        <footer class="form-actions">
                            {{if not .Revealed}}
                            <form method="post" action="{{.RevealURL}}">
                                {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit" class="btn btn-secondary">{{ t "owner_tokens.reveal" }}</button>
                            </form>
                            {{end}}
                            <form method="post" action="{{.RotateURL}}">
                                {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit" class="btn btn-secondary">{{ t "owner_tokens.rotate" }}</button>
                            </form>
                            <details >
                                <summary>{{ t "owner_tokens.edit" }}</summary>
                                <form method="post" action="{{.UpdateURL}}">
                                    {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}
                                    <label>{{ t "owner_tokens.name" }} <input class="form-input" name="name" value="{{.Name}}" required minlength="1" maxlength="64"></label>
                                    <label>{{ t "owner_tokens.expiry" }}
                                        <select class="form-input" name="expires_preset">
                                            <option value="never"{{if eq .Expires "never"}} selected{{end}}>{{ t "owner_tokens.never" }}</option>
                                            <option value="7d">{{ t "owner_tokens.days_7" }}</option><option value="30d">{{ t "owner_tokens.days_30" }}</option><option value="90d">{{ t "owner_tokens.days_90" }}</option><option value="1y">{{ t "owner_tokens.year_1" }}</option><option value="custom"{{if ne .Expires "never"}} selected{{end}}>{{ t "owner_tokens.custom_date" }}</option>
                                        </select>
                                    </label>
                                    <details{{if ne .Expires "never"}} open{{end}}><summary>{{ t "owner_tokens.custom_date" }}</summary><label>{{ t "owner_tokens.expires_on" }} <input class="form-input" type="date" name="expires_date" value="{{if ne .Expires "never"}}{{.Expires}}{{end}}"></label></details>
                                    <button type="submit" class="btn btn-secondary">{{ t "owner_tokens.save" }}</button>
                                </form>
                            </details>
                            <details class=" ">
                                <summary class="btn btn-danger">{{ t "owner_tokens.revoke" }}</summary>
                                <form method="post" action="{{.RevokeURL}}">
                                    {{if $.CSRFToken}}<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">{{end}}<button type="submit" class="btn btn-danger">{{ t "owner_tokens.confirm_revoke" }}</button>
                                </form>
                            </details>
                        </footer>
                        {{end}}
                    </article>
                    {{end}}
                </div>
                {{else}}
                <p>{{ t "owner_tokens.no_linked_tokens" }}</p>
                <p>{{ t "owner_tokens.no_linked_tokens_hint" }}</p>
                {{end}}
            </section>
        </div>
        {{else}}
        <section class="section-card" aria-labelledby="create-owner-token-heading">
            <h2 id="create-owner-token-heading">{{ t "owner_tokens.create_token" }}</h2>
            <p>{{ t "owner_tokens.created_description" }}</p>
            <form method="post" action="{{.PathPrefix}}/server/preferences/token/create">
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <button type="submit" class="btn btn-primary">{{ t "owner_tokens.create_token" }}</button>
            </form>
        </section>
        <section class="section-card" aria-labelledby="restore-token-heading">
            <h2 id="restore-token-heading">{{ t "owner_tokens.restore_identity" }}</h2>
            <form method="post" action="{{.PathPrefix}}/server/preferences/token/restore" >
                {{if .CSRFToken}}<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">{{end}}
                <label for="">{{ t "owner_tokens.primary_token" }}</label>
                <input id="" name="token" type="password" autocomplete="off" placeholder="{{ t "owner_tokens.paste_hint" }}" required>
                <button type="submit" class="btn btn-primary">{{ t "owner_tokens.restore_identity" }}</button>
            </form>
        </section>
        {{end}}
        </div>
    </main>
    {{template "public/footer" .}}

</body>
</html>
{{end}}
