{{define "public/nav"}}
<nav class="nav-links" id="navigation" aria-label="{{ t "a11y.main_nav" }}">
    <a href="{{ path "/" }}" class="nav-link{{if eq .ActiveNav "home"}} active{{end}}"{{if eq .ActiveNav "home"}} aria-current="page"{{end}}>{{ t "nav.home" }}</a>
    <a href="{{ path "/favorites" }}" class="nav-link{{if eq .ActiveNav "favorites"}} active{{end}}"{{if eq .ActiveNav "favorites"}} aria-current="page"{{end}}>{{ t "nav.favorites" }}</a>
</nav>
<label for="nav-toggle" class="nav-toggle" aria-label="{{ t "a11y.open_menu" }}"><span aria-hidden="true">☰</span></label>
{{end}}

{{define "public/nav-panel"}}
<nav class="nav-panel" id="nav-panel" aria-label="{{ t "a11y.main_nav" }}">
    <label for="nav-toggle" class="nav-panel-close" aria-label="{{ t "a11y.close_menu" }}">×</label>
    <a href="{{ path "/" }}" class="nav-panel-link{{if eq .ActiveNav "home"}} active{{end}}"{{if eq .ActiveNav "home"}} aria-current="page"{{end}}>{{ t "nav.home" }}</a>
    <a href="{{ path "/favorites" }}" class="nav-panel-link{{if eq .ActiveNav "favorites"}} active{{end}}"{{if eq .ActiveNav "favorites"}} aria-current="page"{{end}}>{{ t "nav.favorites" }}</a>
</nav>
<label for="nav-toggle" class="nav-overlay" aria-label="{{ t "a11y.close_menu" }}"></label>
{{end}}
