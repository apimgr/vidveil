{{/* Modal dialog component per AI.md PART 16 */}}
{{define "modal"}}
<dialog id="{{.ID}}" class="modal" role="dialog" aria-modal="true" aria-labelledby="{{.ID}}-title">
  <div class="modal-header">
    <h3 class="modal-title" id="{{.ID}}-title">{{.Title}}</h3>
    {{/* form method="dialog" closes natively — zero JS, CSP-safe per AI.md PART 16 */}}
    <form method="dialog">
      <button type="submit" class="modal-close" aria-label="{{ t "a11y.close_dialog" }}">&times;</button>
    </form>
  </div>
  <div class="modal-body">
    {{.Content}}
  </div>
  {{if .ShowFooter}}
  <div class="modal-footer">
    {{/* form method="dialog" closes natively — zero JS, CSP-safe per AI.md PART 16 */}}
    <form method="dialog">
      <button type="submit" class="btn btn-secondary">{{ t "action.cancel" }}</button>
    </form>
    <button type="button" class="btn btn-primary" id="{{.ID}}-confirm">{{ t "action.confirm" }}</button>
  </div>
  {{end}}
</dialog>
{{end}}
