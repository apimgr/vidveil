{{define "healthz"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
</head>
<body>
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    {{template "public/header" .}}
    {{template "public/nav" .}}
    <main id="main-content" role="main" class="content-area health-status">
        <!-- Project Info per AI.md PART 13 -->
        <header class="health-header">
            <h1>📦 {{.ProjectName}}</h1>
            <p class="tagline">{{.ProjectTagline}}</p>
            <p class="project-description">{{.ProjectDescription}}</p>
        </header>

        <h2>🏥 System Health</h2>

        <!-- Status Banner per AI.md PART 13 -->
        <div class="status-banner status-{{.StatusClass}}">
            <span class="status-icon">{{.StatusIcon}}</span>
            <span class="status-text">{{.StatusText}}</span>
        </div>

        <!-- Version & Build Info per AI.md PART 13 -->
        <section class="health-section">
            <h2>ℹ️ Version</h2>
            <dl class="info-grid">
                <dt>🏷️ Version</dt><dd><code>{{.Version}}</code></dd>
                <dt>🐹 Go Version</dt><dd><code>{{.GoVersion}}</code></dd>
                <dt>🔨 Build</dt><dd><code>{{.BuildCommit}}</code> ({{.BuildDate}})</dd>
                <dt>⏱️ Uptime</dt><dd>{{.Uptime}}</dd>
                <dt>🚀 Mode</dt><dd><span class="badge badge-{{.Mode}}">{{.ModeDisplay}}</span></dd>
            </dl>
        </section>

        <!-- Features per AI.md PART 13 (VidVeil: stateless per IDEA.md) -->
        <section class="health-section">
            <h2>🎛️ Features</h2>
            <ul class="feature-list">
                <li class="{{if .Features.TorEnabled}}feature-enabled{{else if .Features.TorStarting}}feature-starting{{else}}feature-disabled{{end}}">
                    🧅 Tor: {{if .Features.TorEnabled}}<span class="status-ok">✅ {{.Features.TorStatus}}</span> <code>{{.Features.TorOnionAddr}}</code>{{else if .Features.TorStarting}}<span class="status-starting">⏳ Connecting...</span>{{else}}<span class="status-disabled">Disabled</span>{{end}}
                </li>
                <li class="{{if .Features.GeoIP}}feature-enabled{{else}}feature-disabled{{end}}">
                    🌍 GeoIP: {{if .Features.GeoIP}}<span class="status-ok">✅ Enabled</span>{{else}}<span class="status-disabled">Disabled</span>{{end}}
                </li>
            </ul>
        </section>

        <!-- Component Checks per AI.md PART 13 -->
        <section class="health-section">
            <h2>🔧 Component Status</h2>
            <table class="checks-table">
                <thead><tr><th>Component</th><th>Status</th></tr></thead>
                <tbody>
                    <tr>
                        <td>🗄️ Database</td>
                        <td class="status-{{if eq .Checks.Database "ok"}}ok{{else}}error{{end}}">{{if eq .Checks.Database "ok"}}✅ OK{{else}}❌ Error{{end}}</td>
                    </tr>
                    <tr>
                        <td>💾 Cache</td>
                        <td class="status-{{if eq .Checks.Cache "ok"}}ok{{else}}error{{end}}">{{if eq .Checks.Cache "ok"}}✅ OK{{else}}❌ Error{{end}}</td>
                    </tr>
                    <tr>
                        <td>💿 Disk</td>
                        <td class="status-{{if eq .Checks.Disk "ok"}}ok{{else}}error{{end}}">{{if eq .Checks.Disk "ok"}}✅ OK{{else}}❌ Error{{end}}</td>
                    </tr>
                    <tr>
                        <td>⏰ Scheduler</td>
                        <td class="status-{{if eq .Checks.Scheduler "ok"}}ok{{else}}error{{end}}">{{if eq .Checks.Scheduler "ok"}}✅ OK{{else}}❌ Error{{end}}</td>
                    </tr>
                </tbody>
            </table>
        </section>

        <!-- Statistics per AI.md PART 13 -->
        <section class="health-section">
            <h2>📈 Statistics</h2>
            <dl class="info-grid stats-grid">
                <dt>📥 Total Requests</dt><dd>{{.Stats.RequestsTotal}}</dd>
                <dt>📅 Requests (24h)</dt><dd>{{.Stats.Requests24h}}</dd>
                <dt>🔌 Active Connections</dt><dd>{{.Stats.ActiveConnections}}</dd>
            </dl>
        </section>

        <!-- Last Updated per AI.md PART 13 -->
        <footer class="health-footer">
            <p>Last checked: <time id="hz-timestamp" datetime="{{.Timestamp}}">{{.TimestampDisplay}}</time></p>
            <p class="auto-refresh">Auto-refreshing in <span id="countdown">30</span>s</p>
        </footer>
    </main>
    {{template "public/footer" .}}
    {{template "public/scripts" .}}
    {{/* Health auto-refresh logic lives in static/js/app.js (CSP: script-src 'self') */}}
</body>
</html>
{{end}}
