{{define "nojs/preferences-sync"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    {{template "public/head" .}}
</head>
<body>
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    <a href="#navigation" class="skip-link">{{ t "a11y.skip_to_nav" }}</a>
    {{template "public/site-banner" .}}
    {{template "public/header" .}}
    <main id="main-content" role="main">
      <div class="container container-md">
        <header class="page-header">
            <nav class="breadcrumb" aria-label="{{ t "a11y.breadcrumb" }}"><a href="{{ path "/server/preferences" }}">{{ t "prefs.title" }}</a></nav>
            <h1 class="page-title">{{ t "prefs.sync" }}</h1>
            <p class="page-lead">{{ t "prefs.sync_desc" }}</p>
        </header>
        <section class="section-card" aria-labelledby="sync-export-heading">
            <h2 id="sync-export-heading">{{ t "prefs.sync_export" }}</h2>
            <div class="form-group">
                <label for="sync-url">{{ t "prefs.sync_url_label" }}</label>
                <input class="form-input copy-value" type="text" id="sync-url" readonly value="{{.PreferenceExportURL}}">
            </div>
            <div class="form-group">
                <label for="sync-code">{{ t "prefs.sync_code_label" }}</label>
                <input class="form-input copy-value" type="text" id="sync-code" readonly value="{{.PreferenceExportCode}}">
            </div>
        </section>
        <section class="section-card" aria-labelledby="sync-import-heading">
            <h2 id="sync-import-heading">{{ t "prefs.sync_import" }}</h2>
            <form method="post" action="{{ path "/server/preferences/sync" }}">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <div class="form-group">
                    <label for="sync-import-code">{{ t "prefs.sync_import_label" }}</label>
                    <input class="form-input" type="text" id="sync-import-code" name="code" placeholder="{{ t "prefs.sync_import_placeholder" }}">
                </div>
                <button type="submit" class="btn btn-primary">{{ t "prefs.sync_import" }}</button>
            </form>
        </section>
      </div>
    </main>
    {{template "public/footer" .}}

</body>
</html>
{{end}}
