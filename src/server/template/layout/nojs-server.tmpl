{{define "server-nojs"}}
<!DOCTYPE html>
<html lang="{{.Lang}}" dir="{{.Dir}}" class="theme-{{.Theme}}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <title>{{.Title}}</title>
    {{range docsStylesheets}}<link rel="stylesheet" href="{{asset .}}">
    {{end}}
    <link rel="stylesheet" href="{{ asset "/static/css/common.css" }}">
    <link rel="stylesheet" href="{{ asset "/static/css/components.css" }}">
    <link rel="stylesheet" href="{{ asset "/static/css/public.css" }}">
    <link rel="manifest" href="{{ path "/manifest.json" }}">
</head>
<body>
    <a href="#main-content" class="skip-link">{{ t "a11y.skip_to_main" }}</a>
    <a href="#navigation" class="skip-link">{{ t "a11y.skip_to_nav" }}</a>
    {{ trackingNoScript }}
    {{template "public/site-banner" .}}
    {{template "public/header" .}}
    <main id="main-content" role="main">
        {{template "content" .}}
    </main>
    {{template "public/footer" .}}
</body>
</html>
{{end}}
