{{define "server-help-mcp"}}
{{template "public" .}}
{{end}}

{{define "content"}}
<div class="container container-md">
    <header class="page-header">
        <nav class="breadcrumb" aria-label="{{ t "a11y.breadcrumb" }}"><a href="{{ path "/server/help" }}">{{ t "nav.back_to_help" }}</a></nav>
        <h1 class="page-title">{{ t "mcp.title" }}</h1>
        <p class="page-lead">{{ t "mcp.overview_body" }}</p>
    </header>

        <section class="section-card" id="overview" aria-labelledby="mcp-overview-heading">
            <h2 id="mcp-overview-heading">{{ t "mcp.overview_title" }}</h2>
            <p>{{ t "mcp.overview_body" }}</p>
        </section>

        <section class="section-card" id="endpoint" aria-labelledby="mcp-endpoint-heading">
            <h2 id="mcp-endpoint-heading">{{ t "mcp.endpoint_title" }}</h2>
            <p>{{ t "mcp.endpoint_body" }}</p>
            <label for="mcp-endpoint">{{ t "mcp.canonical_url" }}</label>
            <input id="mcp-endpoint" class="form-input copy-value" type="text" readonly value="{{.MCPURL}}" aria-label="{{ t "mcp.canonical_url" }}">
            <button type="button" class="copy-btn" data-copy="{{.MCPURL}}" aria-label="{{ t "mcp.copy_endpoint" }}"><span class="copy-text" aria-live="polite">{{ t "action.copy" }}</span></button>
            <ul>
                <li>{{ t "mcp.alias" }}: <code>{{.MCPAPIURL}}</code></li>
                <li>{{ t "mcp.alias" }}: <code>{{.MCPAliasURL}}</code></li>
            </ul>
        </section>

        <section class="section-card" id="authentication" aria-labelledby="mcp-authentication-heading">
            <h2 id="mcp-authentication-heading">{{ t "mcp.authentication_title" }}</h2>
            <p>{{ t "mcp.auth_intro" }} <a href="{{ path "/server/preferences/tokens" }}">{{ t "owner_tokens.title" }}</a> {{ t "mcp.auth_link_tail" }} {{ t "mcp.auth_warning" }}</p>
        </section>

        <section class="section-card" id="connect" aria-labelledby="mcp-connect-heading">
            <h2 id="mcp-connect-heading">{{ t "mcp.connect_title" }}</h2>
            <h3>{{ t "mcp.claude_heading" }}</h3>
            <div class="code-block"><pre><code>claude mcp add --transport http {{.MCPProjectName}} {{.MCPURL}} --header "Authorization: Bearer $MCP_TOKEN"</code></pre>
                <button type="button" class="copy-btn" aria-label="{{ t "action.copy" }}"><span class="copy-icon">📋</span><span class="copy-text" aria-live="polite">{{ t "action.copy" }}</span></button>
            </div>
            <h3>{{ t "mcp.json_heading" }}</h3>
            <div class="code-block"><pre><code>{
  "mcpServers": {
    "{{.MCPProjectName}}": {
      "type": "http",
      "url": "{{.MCPURL}}",
      "headers": {
        "Authorization": "Bearer $MCP_TOKEN"
      }
    }
  }
}</code></pre>
                <button type="button" class="copy-btn" aria-label="{{ t "action.copy" }}"><span class="copy-icon">📋</span><span class="copy-text" aria-live="polite">{{ t "action.copy" }}</span></button>
            </div>
            <h3>{{ t "mcp.curl_heading" }}</h3>
            <div class="code-block"><pre><code>curl -q -LSsf -X POST '{{.MCPURL}}' \
  -H 'Content-Type: application/json' \
  -H 'Accept: application/json, text/event-stream' \
  -H 'MCP-Protocol-Version: 2026-07-28' \
  -H 'Mcp-Method: tools/list' \
  -H 'Authorization: Bearer '"$MCP_TOKEN" \
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28"},"params":{}}'</code></pre>
                <button type="button" class="copy-btn" aria-label="{{ t "action.copy" }}"><span class="copy-icon">📋</span><span class="copy-text" aria-live="polite">{{ t "action.copy" }}</span></button>
            </div>
        </section>

        <section class="section-card" id="tools" aria-labelledby="mcp-tools-heading">
            <h2 id="mcp-tools-heading">{{ t "mcp.tools_title" }}</h2>
            <p>{{ t "mcp.tools_description" }}</p>
            {{if .MCPTools}}
            <div class="table-wrapper"><table class="data-table">
                <thead><tr><th scope="col">{{ t "mcp.table_tool" }}</th><th scope="col">{{ t "mcp.table_description" }}</th></tr></thead>
                <tbody>{{range .MCPTools}}<tr><td><code>{{.Name}}</code></td><td>{{.Description | markdownToHTML}}</td></tr>{{end}}</tbody>
            </table></div>
            {{else}}
            <p>{{ t "mcp.no_tools" }}</p>
            {{end}}
        </section>

        <section class="section-card" id="limits" aria-labelledby="mcp-limits-heading">
            <h2 id="mcp-limits-heading">{{ t "mcp.limits_title" }}</h2>
            <ul>
                <li>{{ t "mcp.limit_post" }}</li>
                <li>{{ t "mcp.limit_api" }}</li>
                <li>{{ t "mcp.limit_origin" }}</li>
                <li>{{ t "mcp.limit_versions" }}</li>
            </ul>
        </section>

        <section class="section-card" id="troubleshooting" aria-labelledby="mcp-troubleshooting-heading">
            <h2 id="mcp-troubleshooting-heading">{{ t "mcp.troubleshooting_title" }}</h2>
            <div class="table-wrapper"><table class="data-table">
                <thead><tr><th scope="col">{{ t "mcp.table_status" }}</th><th scope="col">{{ t "mcp.table_cause" }}</th><th scope="col">{{ t "mcp.table_action" }}</th></tr></thead>
                <tbody>
                    <tr><td><code>400</code></td><td>{{ t "mcp.error400_cause" }}</td><td>{{ t "mcp.error400_action" }}</td></tr>
                    <tr><td><code>401</code></td><td>{{ t "mcp.error401_cause" }}</td><td>{{ t "mcp.error401_action" }} <a href="{{ path "/server/preferences/tokens" }}">{{ t "owner_tokens.title" }}</a>.</td></tr>
                    <tr><td><code>403</code></td><td>{{ t "mcp.error403_cause" }}</td><td>{{ t "mcp.error403_action" }}</td></tr>
                    <tr><td><code>405</code></td><td>{{ t "mcp.error405_cause" }}</td><td>{{ t "mcp.error405_action" }}</td></tr>
                </tbody>
            </table></div>
        </section>

        <section class="section-card" id="project" aria-labelledby="mcp-project-heading">
            <h2 id="mcp-project-heading">{{ t "mcp.project_title" }}</h2>
            {{.MCPProject | markdownToHTML}}
        </section>
</div>
{{end}}
