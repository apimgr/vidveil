{{define "public/header"}}
<input type="checkbox" id="nav-toggle" class="nav-checkbox" aria-label="{{ t "a11y.open_menu" }}">
<header class="site-header" role="banner">
    <a href="{{ path "/" }}" class="site-brand">
        {{- if .BrandingLogo}}<img src="{{.BrandingLogo}}" srcset="/branding/logo-50.png 50w, /branding/logo-200.png 200w" sizes="(max-width: 600px) 50px, 200px" alt="{{if .ProjectName}}{{.ProjectName}}{{else}}{{ t "app.name" }}{{end}}" class="site-brand-logo">
        {{- else}}{{if .ProjectName}}{{.ProjectName}}{{else}}{{ t "app.name" }}{{end}}
        {{- end}}
    </a>
    {{template "public/nav" .}}
    <div class="site-header-actions">
        <a href="{{ path "/server/preferences" }}" class="header-link" aria-label="{{ t "nav.preferences" }}" title="{{ t "nav.preferences" }}"{{if eq .ActiveNav "preferences"}} aria-current="page"{{end}}>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
        </a>
        {{if not .HideThemeToggle}}<form action="{{ path "/server/preferences" }}" method="post" class="theme-toggle-form" aria-label="{{ t "a11y.theme_toggle" }}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="redirect" value="{{.CurrentPath}}">
            <input type="hidden" name="theme" value="{{.NextTheme}}">
            <button type="submit" class="header-action theme-button" aria-label="{{ tf "a11y.switch_theme" "theme" .Theme }}" title="{{ t "a11y.switch_theme_title" }}">
                <svg class="icon-dark" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                <svg class="icon-light" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line></svg>
                <svg class="icon-auto" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor" stroke="none"></path></svg>
            </button>
        </form>{{end}}
    </div>
    {{ operatorHTML "header" }}
</header>
{{template "public/nav-panel" .}}
{{end}}
